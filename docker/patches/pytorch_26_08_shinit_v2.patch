--- a/etc/shinit_v2
+++ b/etc/shinit_v2
@@ -65,20 +65,21 @@
 # GCP detection: try multiple independent signals because newer machine types
 # (A3-mega, A4) don't expose SMBIOS to the guest, so the DMI path alone misses
 # them. Order: cheapest+most-specific first.
-_is_gcp_host() {
+_is_gcp_host() (
+    set +x
     # gVNIC driver bound to at least one PCI device — works on A3/A3-mega/A4.
     for _d in /sys/bus/pci/drivers/gve/*:*; do
         [ -e "$_d" ] && return 0
     done
     # Any PCI device with Google's vendor ID (0x1ae0) — covers the case where
     # the gve driver is shipped but not yet bound.
     for _v in /sys/bus/pci/devices/*/vendor; do
         [ -r "$_v" ] && [ "$(cat "$_v")" = "0x1ae0" ] && return 0
     done
     # SMBIOS — original signal, still works on N1/N2/A2/A3 families.
     [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = "Google Compute Engine" ] && return 0
     [ "$(cat /sys/class/dmi/id/sys_vendor   2>/dev/null)" = "Google" ] && return 0
     return 1
-}
+)
 
 # The gIB plugin is RoCE over the MRDMA NICs (ConnectX-7/CX-8, mlx5 class)
