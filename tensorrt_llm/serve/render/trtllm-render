"""``trtllm-render`` entry point.

``import tensorrt_llm`` links ``libcuda.so.1``, which a container with no GPU does not have. When it cannot
be loaded, this loads the CUDA toolkit stub in its place so the renderer starts on a CPU-only host. It is a
script outside the package so that importing ``tensorrt_llm`` anywhere else is unchanged.
"""

import ctypes
import glob
import os
import sys
import warnings


def _load_cuda_stub_if_needed() -> None:
    try:
        ctypes.CDLL("libcuda.so.1")
        return
    except OSError:
        pass
    roots = [os.environ["CUDA_HOME"]] if os.environ.get("CUDA_HOME") else []
    roots.append("/usr/local/cuda*")
    stubs = [
        stub
        for root in roots
        for pattern in ("lib64/stubs/libcuda.so", "targets/*/lib/stubs/libcuda.so")
        for stub in sorted(glob.glob(os.path.join(root, pattern)))
    ]
    if not stubs:
        sys.exit(
            "trtllm-render: libcuda.so.1 not found and no CUDA toolkit stub under "
            "$CUDA_HOME or /usr/local/cuda*; install the CUDA toolkit stubs or expose a GPU driver"
        )
    ctypes.CDLL(stubs[0], mode=ctypes.RTLD_GLOBAL)
    warnings.filterwarnings("ignore", message="CUDA initialization:", category=UserWarning)
    print(
        f"trtllm-render: no GPU driver found; running CPU-only with the CUDA toolkit stub ({stubs[0]}).",
        file=sys.stderr,
        flush=True,
    )


def main() -> None:
    _load_cuda_stub_if_needed()
    from tensorrt_llm.serve.render.__main__ import main as render_main

    render_main()


if __name__ == "__main__":
    main()
