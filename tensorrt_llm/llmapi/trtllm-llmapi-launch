set -Eeo pipefail

task_with_command=("$@")
native_mpi_rank=$OMPI_COMM_WORLD_RANK
mpi_rank=${SLURM_PROCID:-${OMPI_COMM_WORLD_RANK:-${PMI_RANK:-${PMI_ID:-0}}}}

flashinfer_workspace_lock_held=0
flashinfer_temporary_workspace=
owned_child_pids=()
owned_payload_pgids=()
owned_ready_files=()
owned_guard_active=()
guard_directory=

log_stderr() { echo -e "\033[33m$@\033[0m" >&2; }
log_stderr "mpi_rank: $mpi_rank"

# Allow TLLM_MGMN_SHUTDOWN_GRACE_SECONDS plus cold stop-helper startup/import,
# communication and cleanup overhead. Increase this budget when raising that grace.
stop_timeout=${TLLM_LLMAPI_LAUNCH_STOP_TIMEOUT:-120}
if [[ ! "$stop_timeout" =~ ^[1-9][0-9]*$ ]] || [ "${#stop_timeout}" -gt 6 ]; then
    log_stderr "TLLM_LLMAPI_LAUNCH_STOP_TIMEOUT must be a positive integer of at most six digits"
    exit 2
fi
term_grace_seconds=${TLLM_LLMAPI_LAUNCH_TERM_GRACE_SECONDS:-5}
if [[ ! "$term_grace_seconds" =~ ^[1-9][0-9]*$ ]] || [ "${#term_grace_seconds}" -gt 6 ]; then
    log_stderr "TLLM_LLMAPI_LAUNCH_TERM_GRACE_SECONDS must be a positive integer of at most six digits"
    exit 2
fi

# Tell TRTLLM to spawn a additional process for the Proxy
export TLLM_SPAWN_PROXY_PROCESS=1

function mpi_world_size {
    if [ -n "$SLURM_NTASKS" ]; then
        echo "$SLURM_NTASKS"
    elif [ -n "$OMPI_COMM_WORLD_SIZE" ]; then
        echo "$OMPI_COMM_WORLD_SIZE"
    elif [ -n "$PMI_SIZE" ]; then
        echo "$PMI_SIZE"
    else
        echo "1"
    fi
}

# A completed guard holds its workload leader unreaped until we retire the
# registration. This pins the process group identity through the last signal.
function command_running {
    local child_pid=$1
    local index
    for index in "${!owned_child_pids[@]}"; do
        [ "${owned_child_pids[$index]}" = "$child_pid" ] || continue
        [ "${owned_guard_active[$index]}" -eq 1 ] || return 1
        if [ -f "${owned_ready_files[$index]}.done" ]; then
            owned_guard_active[$index]=0
            if ! : > "${owned_ready_files[$index]}.reap"; then
                log_stderr "Failed to acknowledge process guard completion"
                # The guard still pins the group until this acknowledgment.
                kill -KILL -- "-${owned_payload_pgids[$index]}" 2>/dev/null || true
                kill -KILL -- "-$child_pid" 2>/dev/null || true
            fi
            wait "$child_pid" 2>/dev/null || true
            return 1
        fi
    done
    kill -0 "$child_pid" 2>/dev/null
}

# Wait budgets count 100ms sleeps; polling work and scheduling delays add time.
function cleanup_owned_children {
    local index child_pid payload_pgid
    local cleanup_polls_remaining=$((term_grace_seconds * 10))
    local children_alive

    for index in "${!owned_child_pids[@]}"; do
        child_pid=${owned_child_pids[$index]}
        command_running "$child_pid" || true
        [ "${owned_guard_active[$index]}" -eq 1 ] || continue
        # Signal the guard too, including a guard still registering its payload.
        kill -TERM -- "-$child_pid" 2>/dev/null || true
    done
    while true; do
        children_alive=0
        for index in "${!owned_child_pids[@]}"; do
            [ "${owned_guard_active[$index]}" -eq 1 ] || continue
            if command_running "${owned_child_pids[$index]}"; then
                children_alive=1
            fi
        done
        [ "$children_alive" -eq 0 ] && break
        [ "$cleanup_polls_remaining" -eq 0 ] && break
        sleep 0.1
        cleanup_polls_remaining=$((cleanup_polls_remaining - 1))
    done
    for index in "${!owned_child_pids[@]}"; do
        child_pid=${owned_child_pids[$index]}
        [ "${owned_guard_active[$index]}" -eq 1 ] || continue
        payload_pgid=${owned_payload_pgids[$index]}
        # A guard can publish readiness while EXIT cleanup is already running.
        if [ -z "$payload_pgid" ] && [ -f "${owned_ready_files[$index]}" ]; then
            read -r payload_pgid < "${owned_ready_files[$index]}"
        fi
        if [[ "$payload_pgid" =~ ^[1-9][0-9]*$ ]]; then
            kill -KILL -- "-$payload_pgid" 2>/dev/null || true
        fi
        owned_guard_active[$index]=0
        if ! : > "${owned_ready_files[$index]}.reap"; then
            log_stderr "Failed to acknowledge process guard cleanup"
            kill -KILL -- "-$child_pid" 2>/dev/null || true
        fi
        # Reap the guard after it has killed/reaped its workload. Never kill a
        # guard ahead of its payload group, including during startup.
        wait "$child_pid" 2>/dev/null || true
    done
}

function cleanup_launcher {
    local exit_status=$?

    trap - INT TERM
    cleanup_owned_children
    if [ -n "$guard_directory" ]; then
        rm -rf -- "$guard_directory"
    fi

    if [ -n "$flashinfer_temporary_workspace" ]; then
        if ! rm -rf -- "$flashinfer_temporary_workspace"; then
            log_stderr "Failed to remove temporary FlashInfer JIT workspace: $flashinfer_temporary_workspace"
        fi
    fi

    trap - EXIT
    exit "$exit_status"
}

trap cleanup_launcher EXIT

function use_unique_flashinfer_workspace {
    local temporary_root=${TMPDIR:-/tmp}
    local workspace

    if ! workspace=$(mktemp -d "$temporary_root/trtllm-flashinfer-rank-${mpi_rank}.XXXXXXXX"); then
        log_stderr "Failed to create a temporary FlashInfer JIT workspace; aborting launch"
        exit 1
    fi

    flashinfer_temporary_workspace="$workspace"
    export FLASHINFER_WORKSPACE_BASE="$workspace"
    export TRTLLM_FLASHINFER_WORKSPACE_MANAGED=1
    log_stderr "Using temporary FlashInfer JIT workspace after persistent workspace isolation failed: $FLASHINFER_WORKSPACE_BASE"
}

function try_lock_flashinfer_workspace {
    # flock(2) is attached to the inherited open file description, so the lock
    # remains held by this launcher after the Python helper exits. Disable site
    # initialization so startup hooks cannot import FlashInfer before setup.
    python3 -S - 200 <<'PY'
import sys

try:
    import fcntl

    fcntl.flock(int(sys.argv[1]), fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit(1)
except (ImportError, OSError, TypeError, ValueError) as error:
    print(f"Failed to lock the FlashInfer JIT workspace: {error}", file=sys.stderr)
    sys.exit(2)
PY
}

# FLASHINFER_CUBIN_DIR is left unset so FlashInfer keeps downloaded artifacts,
# which include compiler inputs, inside the per-rank workspace. A caller-set
# value is preserved. See docs/source/llm-api/index.md.
function configure_flashinfer_workspace {
    # PMI_RANK or PMI_ID still proves that this process is launcher-managed
    # when PMI_SIZE is unavailable. Isolate even rank 0 in that case so rank-0
    # processes from concurrent jobs cannot share FlashInfer's default workspace.
    if [ -n "$FLASHINFER_WORKSPACE_BASE" ] || \
        { [ "$tllm_mpi_size" -le 1 ] && [ -z "$PMI_RANK" ] && [ -z "$PMI_ID" ]; } || \
        [ "${TRTLLM_FLASHINFER_WORKSPACE_PER_PROCESS:-1}" = "0" ]; then
        return
    fi

    # Do not overwrite a descriptor inherited from the launcher caller. A
    # process-unique workspace still provides safe isolation in this rare case.
    if { true >&200; } 2>/dev/null; then
        log_stderr "File descriptor 200 is already open; persistent FlashInfer JIT workspace isolation is unavailable"
        use_unique_flashinfer_workspace
        return
    fi

    if [ -z "$HOME" ]; then
        log_stderr "HOME is unset; persistent FlashInfer JIT workspace isolation is unavailable"
        use_unique_flashinfer_workspace
        return
    fi

    local workspace_root="$HOME/.cache/tensorrt_llm/flashinfer"
    if ! mkdir -p "$workspace_root"; then
        log_stderr "Failed to create the persistent FlashInfer JIT workspace root: $workspace_root"
        use_unique_flashinfer_workspace
        return
    fi

    local workspace_slot="$mpi_rank"
    local workspace
    local lock_status
    # Slots intentionally persist for JIT cache reuse. Contention can create
    # additional rank-N slots up to the high-water mark of concurrent jobs.
    while true; do
        workspace="$workspace_root/rank-$workspace_slot"
        if ! mkdir -p "$workspace" || ! exec 200>>"$workspace/.lock"; then
            log_stderr "Failed to prepare the persistent FlashInfer JIT workspace: $workspace"
            exec 200>&-
            use_unique_flashinfer_workspace
            return
        fi

        if try_lock_flashinfer_workspace; then
            flashinfer_workspace_lock_held=1
            export FLASHINFER_WORKSPACE_BASE="$workspace"
            export TRTLLM_FLASHINFER_WORKSPACE_MANAGED=1
            log_stderr "FlashInfer JIT workspace: $FLASHINFER_WORKSPACE_BASE"
            return
        else
            lock_status=$?
        fi

        exec 200>&-
        if [ "$lock_status" -ne 1 ]; then
            use_unique_flashinfer_workspace
            return
        fi
        workspace_slot=$((workspace_slot + tllm_mpi_size))
    done
}

function run_child_command {
    if [ "$flashinfer_workspace_lock_held" -eq 1 ]; then
        "$@" 200>&-
    else
        "$@"
    fi
}

function maybe_export_free_tcp_addr_for_spawn_proxy_process {
    # use user specified address if provided
    if [ -n "$TLLM_SPAWN_PROXY_PROCESS_IPC_ADDR" ]; then
        log_stderr "Using user-provided TLLM_SPAWN_PROXY_PROCESS_IPC_ADDR: $TLLM_SPAWN_PROXY_PROCESS_IPC_ADDR"
        return
    fi

    # Generate unique IPC address without importing tensorrt_llm to avoid MPI initialization conflicts
    local free_port=$(python3 -c "import uuid, tempfile, os; print(f'ipc://{os.path.join(tempfile.gettempdir(), \"rpc_test_\" + str(uuid.uuid4()))}')")
    export TLLM_SPAWN_PROXY_PROCESS_IPC_ADDR=$free_port
    log_stderr "TLLM_SPAWN_PROXY_PROCESS_IPC_ADDR: $TLLM_SPAWN_PROXY_PROCESS_IPC_ADDR"
}


tllm_mpi_size=$(mpi_world_size)
export tllm_mpi_size
log_stderr "tllm_mpi_size: $tllm_mpi_size"
configure_flashinfer_workspace

unset TLLM_SPAWN_PROXY_PROCESS_IPC_HMAC_KEY

# The launcher owns the workspace lock. Long-lived child commands close its
# descriptor so detached descendants cannot keep a stale slot locked.
if [ -z "$mpi_rank" ] || [ "$mpi_rank" -eq 0 ]; then
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if ! hmac_key=$(openssl rand -hex 32); then
        log_stderr "Failed to generate TLLM_SPAWN_PROXY_PROCESS_IPC_HMAC_KEY"
        exit 1
    fi
    if [[ ! "$hmac_key" =~ ^[0-9a-fA-F]{64}$ ]]; then
        log_stderr "Generated invalid TLLM_SPAWN_PROXY_PROCESS_IPC_HMAC_KEY"
        exit 1
    fi
    export TLLM_SPAWN_PROXY_PROCESS_IPC_HMAC_KEY="$hmac_key"

    # IPC only works on localhost and in MPI rank0 process
    maybe_export_free_tcp_addr_for_spawn_proxy_process

    log_stderr "Rank${mpi_rank} run ${task_with_command[@]} in background"

    # MPI doesn't allow spawn a process sharing the MPI environment in a MPI
    # process, or duplicate MPI_Init in the child process will cause undefined
    # behavior. Thus we need to clean the MPI environment in the parent process
    # before spawning the child process, and restore the MPI environment later
    # before running MPI operations in the parent process.
    mpi_blacklist=(
        OMPI_ PMIX_ PMI_ SLURM_ MPI_ UCX_
        I_MPI_ HYDRA_ KMP_ MPICH_ MV2_ CRAY_
    )

    function exec_child_command {
        if [ "$flashinfer_workspace_lock_held" -eq 1 ]; then
            exec 200>&-
        fi
        exec "$@"
    }

    function exec_without_mpi_environment {
        local var prefix
        for var in $(compgen -e); do
            for prefix in "${mpi_blacklist[@]}"; do
                if [[ "$var" == "$prefix"* ]]; then
                    unset "$var"
                    break
                fi
            done
        done
        exec_child_command "$@"
    }

    guard_path="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/_llmapi_process_guard.py"
    guard_directory=$(mktemp -d "${TMPDIR:-/tmp}/trtllm-launch-guards.XXXXXXXX")

    function start_guarded_command {
        local role=$1
        shift
        local ready_file="$guard_directory/$role"
        local guard_pid payload_pgid guard_exit_code
        local polls_remaining=$((stop_timeout * 10))
        local index=${#owned_child_pids[@]}
        local environment_function=exec_without_mpi_environment
        [ "$role" = server ] && environment_function=exec_child_command
        "$environment_function" python3 -S "$guard_path" \
            --parent-pid "$$" --term-grace "$term_grace_seconds" \
            --ready-file "$ready_file" --go-file "$ready_file.go" \
            --role "$role" -- "$@" < /dev/null &
        guard_pid=$!
        owned_child_pids+=("$guard_pid")
        owned_payload_pgids+=("")
        owned_ready_files+=("$ready_file")
        owned_guard_active+=(1)
        while [ ! -f "$ready_file" ]; do
            if ! kill -0 "$guard_pid" 2>/dev/null; then
                wait "$guard_pid"
                guard_exit_code=$?
                owned_guard_active[$index]=0
                log_stderr "Failed to register $role process guard (status $guard_exit_code)"
                [ "$guard_exit_code" -eq 0 ] && guard_exit_code=1
                return "$guard_exit_code"
            fi
            if [ "$polls_remaining" -eq 0 ]; then
                log_stderr "$role process guard registration exceeded ${stop_timeout}s"
                return 124
            fi
            sleep 0.1
            polls_remaining=$((polls_remaining - 1))
        done
        read -r payload_pgid < "$ready_file"
        if [[ ! "$payload_pgid" =~ ^[1-9][0-9]*$ ]]; then
            log_stderr "Invalid $role process group registration"
            return 1
        fi
        owned_payload_pgids[$index]=$payload_pgid
        log_stderr "Rank${mpi_rank} $role guard PID: $guard_pid; workload PGID: $payload_pgid"
        if ! : > "$ready_file.go"; then
            log_stderr "Failed to release $role process guard"
            return 1
        fi
        started_guard_pid=$guard_pid
    }

    # Guards stay direct children; each owns a separate workload process group.
    set -m
    set +e
    start_guarded_command server python3 -m tensorrt_llm.llmapi.mgmn_leader_node || exit $?
    server_pid=$started_guard_pid
    start_guarded_command task "${task_with_command[@]}" || exit $?
    task_pid=$started_guard_pid

    while command_running "$task_pid"; do
        if ! command_running "$server_pid"; then
            wait "$server_pid"
            server_exit_code=$?
            log_stderr "MPI Comm server exited before the task (status $server_exit_code); waiting up to ${stop_timeout}s for task exit"
            # Even a successful server exit is a failure while its task is alive.
            [ "$server_exit_code" -eq 0 ] && server_exit_code=1
            task_exit_polls_remaining=$((stop_timeout * 10))
            while command_running "$task_pid"; do
                if [ "$task_exit_polls_remaining" -eq 0 ]; then
                    log_stderr "Task exit after MPI Comm server failure exceeded ${stop_timeout}s; terminating owned processes"
                    # Cleanup-induced signal statuses must not replace the
                    # original server failure when the task cannot finish.
                    exit "$server_exit_code"
                fi
                sleep 0.1
                task_exit_polls_remaining=$((task_exit_polls_remaining - 1))
            done
            wait "$task_pid"
            task_exit_code=$?
            log_stderr "Rank${mpi_rank} Task exit code: $task_exit_code"
            # Let the task report its own failure, including errors received
            # from the server, before falling back to the server's status.
            [ "$task_exit_code" -ne 0 ] && exit "$task_exit_code"
            exit "$server_exit_code"
        fi
        sleep 0.1
    done
    wait "$task_pid"
    task_exit_code=$?
    log_stderr "Rank${mpi_rank} Task exit code: $task_exit_code"

    # The wait covers the stop helper's imports, connection, send and queue
    # cleanup as well as the MPI server. Neither child can block this supervisor.
    shutdown_polls_remaining=$((stop_timeout * 10))
    stop_pid=
    if command_running "$server_pid"; then
        if start_guarded_command stop python3 -m tensorrt_llm.llmapi.mgmn_leader_node --action stop; then
            stop_pid=$started_guard_pid
        else
            stop_exit_code=$?
            [ "$task_exit_code" -ne 0 ] && exit "$task_exit_code"
            exit "$stop_exit_code"
        fi
    fi

    shutdown_timed_out=0
    while true; do
        if [ -n "$stop_pid" ] && ! command_running "$stop_pid"; then
            wait "$stop_pid"
            stop_exit_code=$?
            stop_pid=
            log_stderr "Rank${mpi_rank} stop helper exit code: $stop_exit_code"
            # A failed helper cannot be relied on to stop the server.
            if [ "$stop_exit_code" -ne 0 ]; then
                [ "$task_exit_code" -ne 0 ] && exit "$task_exit_code"
                exit "$stop_exit_code"
            fi
        fi
        if ! command_running "$server_pid" && [ -z "$stop_pid" ]; then
            break
        fi
        if [ "$shutdown_polls_remaining" -eq 0 ]; then
            log_stderr "MPI Comm shutdown exceeded ${stop_timeout}s; terminating owned processes"
            shutdown_timed_out=1
            break
        fi
        sleep 0.1
        shutdown_polls_remaining=$((shutdown_polls_remaining - 1))
    done

    if [ "$shutdown_timed_out" -ne 0 ]; then
        [ "$task_exit_code" -ne 0 ] && exit "$task_exit_code"
        exit 124
    fi
    wait "$server_pid"
    server_exit_code=$?
    log_stderr "Rank${mpi_rank} MPI Comm server exit code: $server_exit_code"

    # Preserve the original task failure; otherwise surface teardown failures.
    [ "$task_exit_code" -ne 0 ] && exit "$task_exit_code"
    exit "$server_exit_code"

else
    # Turn off "exit on error" so the following lines always run
    set +e

    log_stderr "Rank${mpi_rank} run mgmn worker node with mpi_world_size: $(mpi_world_size) ..."
    run_child_command python3 -m tensorrt_llm.llmapi.mgmn_worker_node
    mgmn_worker_node_exit_code=$?
    log_stderr "Rank${mpi_rank} MGMN worker node exit code: $mgmn_worker_node_exit_code"

    exit $mgmn_worker_node_exit_code
fi
