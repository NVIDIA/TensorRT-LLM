# w256 "W" stack (TEP8 gen, mbs32): the gated 129..256-row knobs, ON TOP of afcaf734 (lanes/e2e/v11_gen_mbs16_h4.env) +
# ROLE=gen + SWA_ONE_CLUSTER_BLOCK=on/__EXACT=1. Needs branch pcastonguay/mso-vr-tep8-wide256 (>= 4e537b0edb; overlay
# $V/trt-w256/c4 on the caria image). Hecate 1051502: bs20/24/32 10.83/11.80/13.36 ms; GSM8K-long 97.50% vs 97.65%,
# natural AL 4.5232 vs 4.5144 (PASS). Only steps of > 128 rows change.
MUSESPARK_OPEN_LEVER_TEP8_FINALIZE_TRANSPORT_64__CHUNKED=1
MUSESPARK_OPEN_LEVER_TEP8_FINALIZE_TRANSPORT_64__TOKENS=256
MUSESPARK_OPEN_LEVER_TEP8_DIRECT_HOP__MAX_ROWS=256
MUSESPARK_OPEN_LEVER_TEP8_RING_BUDDY_WIDE__MAX_ROWS=256
MUSESPARK_OPEN_LEVER_PREROUTED_EXPERTS__TEP8_MAX_ROWS=256
MUSESPARK_OPEN_LEVER_TEP8_ROUTER_PUSH__TEP8_MAX_ROWS=256
MUSESPARK_OPEN_LEVER_TEP8_WIDE64_SPLITK__MAX_ROWS=256
MUSESPARK_OPEN_LEVER_TEP8_PUBLISH_SPLITK__MAX_ROWS=256
MUSESPARK_OPEN_LEVER_TEP8_WIDE64_SPLITK__PREP_FOLD_MAX_ROWS=256
MUSESPARK_OPEN_LEVER_WIDE_SPLIT_SAMPLER=on
# w256 W2 (11-13 20:30 ET, coordinator: adopt): + two-phase finalize at >= 145 tokens (bitwise where it engages, 8-rank gate 171/171)
# + FULL_ROUTING_TORCH_ORDER=0 (> 128-row routing in the push epilogue, the <= 128-row expert order; GSM8K gate w256-gd 1068269 97.50 %, AL 4.5012 PASS)
MUSESPARK_OPEN_LEVER_TEP8_FINALIZE_TRANSPORT_64__TWO_PHASE_MIN_TOKENS=145
MUSESPARK_OPEN_FULL_ROUTING_TORCH_ORDER=0
# W3 (11-13, USER approved via coordinator): + DIST_CHUNK (129..256-row verify steps on ds_sample in 128-row calls; q04 DSC 80/80, q05 dsdist + SB natural AL D-R +0.009 CI -0.024..+0.043)
MUSESPARK_OPEN_LEVER_WIDE_SPLIT_SAMPLER__DIST_CHUNK=1
# W4 (11-13): + 2cta QKV split_k 2 above 128 rows (one wave; order-only; q07b ABBA -0.33/-0.25/-0.22 at bs20/24/32, GSM8K gate w256-gy 97.50 %, AL 4.4991 PASS). Overlay c8 (b5cc2f1b05). Pass these lines as K=V overrides on the default afcaf734 envf.
MUSESPARK_OPEN_LEVER_TEP8_WIDE64_SPLITK__WIDE2_SPLIT_K=2
# W5 (11-14): + ROUTE_WIDE_V2 (v2-only routed push above 128 rows; bitwise, 8-rank gate 35/35; q10 ABBA on bk2fa + W4 -0.22 / -0.47 / -0.24 ms at bs20/24/32). Overlay c10 (or c11 = bk3fa-merged). Base env: afcaf734 + banked_stack_bk2fa.env (or bk3fa) lines, then these lines, as K=V overrides.
MUSESPARK_OPEN_LEVER_TEP8_ROUTER_PUSH__ROUTE_WIDE_V2=1
# W6 (11-14, coordinator via dieexp): + tile placement to 256 rows / mbs32 (q168x ABBA on c9 -0.432 / -0.403 / -0.193 at bs20/24/32; bundled gate q168zb conc 24 mbs32 + KF651: GSM8K +0.00 pt, AL +0.42 %, 0 errors). Order-only (placement), gated.
MUSESPARK_OPEN_LEVER_TEP8_TILE_PLACEMENT__MAX_ROWS=256
MUSESPARK_OPEN_LEVER_TEP8_TILE_PLACEMENT__MAX_BATCH=32
# W6 + KF651 v2 (11-14 ~19:35 ET, coordinator ask; dieexp ed3e880, banked at bs<=16): q20 (1092246) bits v2 off vs on BITWISE 12/12 (attention-only MR op, R20/24/32 even + uneven) -> no gate; 3 ABBA pairs pooled bs16 -0.09 / bs20 -0.17 / bs24 -0.19 / bs32 -0.08 ms. REQUIRES overlay $V/trt-w256/c13 (or later: c11 + ed3e880 files); inert on c10/c11. Previous file: w256_W6.env.pre-v2.
MUSESPARK_OPEN_DX_MR_KF651_V2=1
