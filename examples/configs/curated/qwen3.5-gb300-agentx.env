# Worker environment shared by the prefill and decode workers of every
# qwen3.5-gb300-agentx-* profile.
export MIMALLOC_ARENA_RESERVE=0
export MIMALLOC_PURGE_DELAY=''
export NCCL_GRAPH_MIXING_SUPPORT=0
export OMPI_MCA_coll='^ucc,hcoll'
export OMP_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TLLM_NUMA_AWARE_WORKER_AFFINITY=1
export TRTLLM_ENABLE_PDL=1
export TRTLLM_KV_TRANSFER_NUM_THREADS=8
export TRTLLM_PINNED_WEIGHT_STAGING=1
export TRTLLM_SERVER_DISABLE_GC=1
export TRTLLM_WORKER_DISABLE_GC=1
export UCX_CUDA_COPY_MAX_POLL=inf
export UCX_CUDA_IPC_MAX_POLL=inf
export UCX_TLS=rc,cuda_ipc,cuda_copy,sm,self,tcp
export DYN_TRTLLM_SERVED_MODEL_NAME=nvidia/Qwen3.5-397B-A17B-NVFP4-V2
