# Cluster settings: copy to cluster.env and edit. run.sh, the job scripts and client/prepare.sh
# source this file with bash.

# Slurm
PARTITION=batch
ACCOUNT=my-account
TIME_LIMIT=04:00:00             # full run: cold start-up (over 1 h from NFS), warmup (3 requests per session), 60-min window
TIME_LIMIT_SMOKE=03:00:00       # mostly start-up: loading 527 GB of weights, JIT and autotuning
HEALTH_TIMEOUT=7200             # seconds each server may take to answer /health
USE_SEGMENT=1                   # 1: --segment=<nodes>, keeps the job in one NVL72 (topology/block clusters)
SBATCH_EXTRA=()                 # e.g. (--qos=high --constraint=nvl72 --nodelist=gb300-[01-09] --switches=1)

# Shared file system, mounted at the same path on every node
SHARED=/shared/dsv41-agentx
# The TensorRT-LLM container: the registry tag (pyxis pulls it on every node of every job), or a
# squashfs imported once (pyxis unpacks it on every node, so keep it on fast storage).
# README: build this checkout with docker/Makefile and export with enroot.
IMAGE=$SHARED/tensorrt-llm-dsv41.sqsh
MODEL_PATH=$SHARED/DeepSeek-V4.1-Flash-NVFP4-3431dde   # HF nvidia/DeepSeek-V4.1-Flash-NVFP4 @ 3431dde
WORK_DIR=$SHARED/runs                                  # one directory per run
CACHE_DIR=$SHARED/cache                                # JIT and autotuner caches shared by runs; empty: per run
STAGE_DIR=                                             # node-local dir: servers load a copy of the checkpoint
                                                       # from there (slurm/stage.sh; kept for later jobs). Use it
                                                       # when MODEL_PATH is on slow shared storage such as NFS
CLIENT_VENV=                                           # empty: each job installs the client into node-local /tmp
CLIENT_HF_HOME=$SHARED/agentx-client/hf                # AgentX dataset cache (client/prepare.sh fills it once)
CLIENT_OFFLINE=0                                       # 1: no internet on compute nodes; needs CLIENT_VENV and the cache
# Bind mounts of every job step; they must cover MODEL_PATH, WORK_DIR, CACHE_DIR and CLIENT_HF_HOME.
CONTAINER_MOUNTS=$SHARED:$SHARED

# Optional: the host-MPI transport between the ranks of a server that spans nodes. The MPI control
# path runs every iteration; NCCL and the KV transfer do not use it. Unset, UCX follows UCX_TLS from
# slurm/worker.sh and uses TCP between nodes. The measured runs used RDMA:
FABRIC_ENV=(
    # MPI_UCX_TLS=rc,ud,sm,self
    # MPI_UCX_NET_DEVICES=mlx5_0:1,mlx5_1:1    # your nodes' RDMA devices
    # OMPI_MCA_coll=^ucc,hcoll
)
