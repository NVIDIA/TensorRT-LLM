# 1xDEP2+4xTEP8 at concurrency 84: 1 context server (DEP2) and 4 generation servers (TEP8).
# 9 nodes, used in this order (as measured):
#   nodes 1-8  generation servers, 2 nodes each, rank 0 on the first; node 1 also runs the orchestrator
#   node 9     context server on GPUs 0,2, and the AgentX client on NUMA node 1

GEN_SERVERS=4
GEN_NODES_PER_SERVER=2          # 4 ranks per node
CTX_SERVERS=1
# GPUs of each context server on a node, in rank order: one GPU on each NUMA node.
CTX_GPU_ORDER=(0,2)
ORCH_NODE=first_gen             # last_gen | first_gen
ORCH_NUMA=                      # numactl --cpunodebind/--preferred node of the orchestrator; empty: none
CLIENT_NODE=ctx                 # dedicated: its own node | ctx: the context node
CLIENT_NUMA=1                   # numactl node of the client; empty: none

CONCURRENCY=84                  # AgentX sessions: 21 per generation server
UCX_WARMUP_REQUESTS=16          # 2 x 1 CTX server x 2 ranks x 4 GEN servers x 1 attention rank
SUBAGENT_SESSION_HEADER=0       # not sent; server.yaml has no subagent routing

# Forced DSpark acceptance, on the context and generation workers
# (TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS): accepted draft tokens per step, the InferenceX
# golden acceptance length minus 1 (k=5: 3.51 - 1). The InferenceX AgentX rules use it, and every
# published number was measured with it. The generated text is then not the model's own. Leave
# empty to measure the model's real acceptance.
FORCE_ACCEPTED_TOKENS=2.51

# Worker environment as measured, minus cluster paths, caches and harness switches
# (slurm/worker.sh sets those).
WORKER_ENV=(
    TLLM_LOG_LEVEL=INFO
    TRTLLM_SERVER_DISABLE_GC=1
    TRTLLM_WORKER_DISABLE_GC=1
    NCCL_GRAPH_MIXING_SUPPORT=0
    MIMALLOC_ARENA_RESERVE=0
    OMP_NUM_THREADS=1
    TLLM_NUMA_AWARE_WORKER_AFFINITY=1
    TRTLLM_PINNED_WEIGHT_STAGING=1
)
CTX_ENV=(
    TLLM_V2_CTX_DEMOTE_UNCACHED_TOKENS=16384
    TLLM_V2_CTX_DEMOTE_MAX_ITERS=16
    TLLM_INDEXER_MQA_LOGITS_ELEM_BUDGET=1073741824
    CUDA_SCALE_LAUNCH_QUEUES=4x
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    TLLM_PROFILE_LOG_RANKS=all
)
GEN_ENV=(
    TLLM_PROFILE_LOG_RANKS=all
)
