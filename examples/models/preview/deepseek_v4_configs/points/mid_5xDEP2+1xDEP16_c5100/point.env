# 5xDEP2+1xDEP16 at concurrency 5,100: 5 context servers (DEP2) and 1 generation server (DEP16).
# 8 nodes, used in this order (as measured):
#   nodes 1-4  generation server, rank 0 on node 1; node 4 also runs the orchestrator
#   nodes 5-7  context servers, two per node on GPUs 0,2 and 3,1 (node 7: one)
#   node 8     AgentX client, alone

GEN_SERVERS=1
GEN_NODES_PER_SERVER=4          # 4 ranks per node
CTX_SERVERS=5
# GPUs of each context server on a node, in rank order; a node's servers take them in this order.
# 0,2 and 3,1 put every server on both NUMA nodes and one server's rank 0 on each NUMA node.
CTX_GPU_ORDER=(0,2 3,1)
ORCH_NODE=last_gen              # last_gen | first_gen
ORCH_NUMA=1                     # numactl --cpunodebind/--preferred node of the orchestrator; empty: none
CLIENT_NODE=dedicated           # dedicated: its own node | ctx: the context node
CLIENT_NUMA=                    # numactl node of the client; empty: none

CONCURRENCY=5100                # AgentX sessions
UCX_WARMUP_REQUESTS=320         # 2 x 5 CTX servers x 2 ranks x 16 GEN ranks
SUBAGENT_SESSION_HEADER=1       # client sends X-Dynamo-Parent-Session-ID (server.yaml routes on it)

# Forced DSpark acceptance, on the context and generation workers
# (TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS): accepted draft tokens per step, the InferenceX
# golden acceptance length minus 1 (k=3: 2.9 - 1). The InferenceX AgentX rules use it, and every
# published number was measured with it. The generated text is then not the model's own. Leave
# empty to measure the model's real acceptance.
FORCE_ACCEPTED_TOKENS=1.9

# Worker environment as measured, minus cluster paths, caches and harness switches
# (slurm/worker.sh sets those).
WORKER_ENV=(
    TLLM_LOG_LEVEL=INFO
    TRTLLM_SERVER_DISABLE_GC=1
    TRTLLM_WORKER_DISABLE_GC=1
    NCCL_GRAPH_MIXING_SUPPORT=0
    MIMALLOC_ARENA_RESERVE=0
    OMP_NUM_THREADS=1
    TLLM_NUMA_AWARE_WORKER_AFFINITY=1
    TRTLLM_PINNED_WEIGHT_STAGING=1
)
CTX_ENV=(
    TLLM_V2_CTX_DEMOTE_UNCACHED_TOKENS=16384
    TLLM_V2_CTX_DEMOTE_MAX_ITERS=16
    TLLM_INDEXER_MQA_LOGITS_ELEM_BUDGET=1073741824
    CUDA_SCALE_LAUNCH_QUEUES=4x
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    TLLM_PROFILE_LOG_RANKS=all
)
GEN_ENV=(
    TLLM_PROFILE_LOG_RANKS=all
)
