"""Portable specification archives. Requires Python 3.9+, Git, and no packages."""
from __future__ import annotations

import argparse
import datetime as dt
import difflib
from email.message import Message
import gzip
import hashlib
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
