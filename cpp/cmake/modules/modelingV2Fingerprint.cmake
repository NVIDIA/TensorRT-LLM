#[[
Write the modeling_v2 contract fingerprint header (build step of
trtllm_mv2_define_contract_fingerprint in modelingV2.cmake).

  cmake -DINPUTS=<contractInputs.txt> -DROOT=<cpp source dir> -DOUTPUT=<header>
        -P modelingV2Fingerprint.cmake

INPUTS has one entry per line: `file:<absolute path>` lines are hashed by
content under their path relative to ROOT, every other line is hashed as is.
The header is rewritten only when the fingerprint changes, so an unchanged
contract recompiles nothing.
#]]

foreach(required INPUTS ROOT OUTPUT)
  if(NOT DEFINED ${required})
    message(
      FATAL_ERROR "modelingV2Fingerprint.cmake: -D${required} is required")
  endif()
endforeach()

file(STRINGS "${INPUTS}" lines)
set(digest_input "")
foreach(line IN LISTS lines)
  if(line MATCHES "^file:(.*)$")
    set(path "${CMAKE_MATCH_1}")
    file(SHA256 "${path}" content_digest)
    file(RELATIVE_PATH relative "${ROOT}" "${path}")
    string(APPEND digest_input "${relative} ${content_digest}\n")
  else()
    string(APPEND digest_input "${line}\n")
  endif()
endforeach()
string(SHA256 fingerprint "${digest_input}")
string(SUBSTRING "${fingerprint}" 0 16 fingerprint)

set(content
    "// Generated by cpp/cmake/modules/modelingV2Fingerprint.cmake. Do not edit.\n"
)
string(APPEND content "#pragma once\n\n")
string(APPEND content
       "#define TRTLLM_MV2_CONTRACT_FINGERPRINT \"${fingerprint}\"\n")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
  if(previous STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
