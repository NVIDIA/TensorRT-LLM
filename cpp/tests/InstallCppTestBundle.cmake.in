# Keep PRE_TEST discovery and properties from the original CTest registration.
# The consumer fills in paths after extracting the bundle next to its sources.
file(GLOB_RECURSE metadata
     "@CMAKE_BINARY_DIR@/tests/CTestTestfile.cmake"
     "@CMAKE_BINARY_DIR@/tests/*_include.cmake")
foreach(path IN LISTS metadata)
  file(READ "${path}" content)
  string(REPLACE "@CMAKE_BINARY_DIR@" "__TRTLLM_CPP_BUNDLE_ROOT__" content
                 "${content}")
  string(REPLACE "@cpp_test_source_root@" "__TRTLLM_CPP_SOURCE_ROOT__" content
                 "${content}")
  file(RELATIVE_PATH relative_path "@CMAKE_BINARY_DIR@" "${path}")
  file(WRITE "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${relative_path}.in"
             "${content}")
endforeach()
file(WRITE "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/CTestTestfile.cmake.in"
           "subdirs(tests)\n")
