+    // With `kPageMask`, a block-table entry whose bits 31..30 are 01 is a masked page: the low 30 bits are
+    // the page to load, and its logits below the row's own context length are written as -inf.
+    static constexpr uint32_t kMaskedPageFlag = 1u << 30;
+
+    CUTLASS_DEVICE static bool is_masked_entry(const uint32_t& entry) {
+        return (entry >> 30) == 1u;
+    }
+
     CUTLASS_DEVICE uint32_t get_kv_page_coord_by_page_offset(const uint32_t& page_offset) const {
         if (page_offset >= cur_request_num_kv_pages)
             return 0;
         const auto block_table_offset = cur_block_table_row * static_cast<uint64_t>(block_table_stride);
+        if constexpr (kPageMask) {
+            const auto entry = block_table[block_table_offset + page_offset];
+            return is_masked_entry(entry) ? entry & (kMaskedPageFlag - 1) : entry;
+        }
         return block_table[block_table_offset + page_offset];
     }
 
+    CUTLASS_DEVICE bool is_masked_page(const uint32_t& page_offset) const {
+        if (page_offset >= cur_request_num_kv_pages)
+            return false;
+        const auto block_table_offset = cur_block_table_row * static_cast<uint64_t>(block_table_stride);
+        return is_masked_entry(block_table[block_table_offset + page_offset]);
+    }
+
+    // A logits row's own context length (2D / varlen context lengths); 0 masks nothing otherwise
+    CUTLASS_DEVICE uint32_t get_row_context_len(const uint32_t& token_row) const {
