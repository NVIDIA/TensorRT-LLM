+def _compute_csrc_fingerprint() -> str:
+    """Fingerprint sources embedded in cached JIT artifacts."""
+    csrc_dir = Path(__file__).resolve().parent / "csrc"
+    digest = hashlib.sha256()
+    for path in sorted(p for p in csrc_dir.rglob("*") if p.is_file()):
+        digest.update(path.relative_to(csrc_dir).as_posix().encode())
+        digest.update(b"\0")
+        digest.update(path.read_bytes())
+    return digest.hexdigest()[:16]
+
+
+# A package upgrade must not load cubins compiled from older headers.
+CACHE_BASE = _compute_cache_base() / f"source-{_compute_csrc_fingerprint()}"
