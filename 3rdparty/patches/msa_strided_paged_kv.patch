+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Stage selected M3 NVFP4 pages into a compact FP8 decode cache.
+
+The output page ``token * topk + slot`` contains one independently selected
+physical source page for each KV head. It is intentionally not a conventional
+paged cache: the planned selected-page decoder addresses it by token and slot,
+while retaining the original logical page in ``q2k`` for causal/Eagle masks.
+"""
+
+from __future__ import annotations
+
+import cuda.bindings.driver as cuda
+import cutlass
+import cutlass.cute as cute
+import torch
+from cutlass import Int32, Int64, const_expr
+
+from src.common.cute_dsl_utils import assume_tensor_aligned
+from src.sm100.fwd.atten_fwd_nvfp4_kv import SparseAttentionForwardNvfp4KvSm100
+
+
+class SelectedNvfp4ToFp8Sm100(SparseAttentionForwardNvfp4KvSm100):
+    """Convert one selected ``(token, head, slot)`` page per CTA."""
+
+    def __init__(
+        self,
+        *,
+        is_v: bool,
+        head_dim: int,
+        num_kv_heads: int,
+        page_size: int,
+        topk: int,
+    ) -> None:
+        if head_dim != 128 or page_size != 128:
+            raise ValueError(
+                "selected NVFP4 staging currently requires D128/P128, "
+                f"got D{head_dim}/P{page_size}"
+            )
+        super().__init__(
+            head_dim=head_dim,
+            qheadperkv=16,
+            paged_kv=True,
+            page_size=page_size,
+        )
+        self.is_v = bool(is_v)
+        self.num_kv_heads = int(num_kv_heads)
+        self.threads = 256
+
+    @cute.jit
+    def __call__(
+        self,
+        mData: cute.Tensor,
+        mScale: cute.Tensor,
+        mQ2k: cute.Tensor,
+        mQBatchRow: cute.Tensor,
+        mPageTable: cute.Tensor,
+        mOut: cute.Tensor,
+        data_page_stride: Int64,
+        data_head_stride: Int64,
+        data_row_stride: Int64,
+        scale_page_stride: Int64,
+        scale_head_stride: Int64,
+        stream: cuda.CUstream,
+    ) -> None:
+        total_tasks = mQ2k.shape[0] * mQ2k.shape[1] * mQ2k.shape[2]
+        self.kernel(
+            assume_tensor_aligned(mData),
+            mScale,
+            mQ2k,
+            mQBatchRow,
+            mPageTable,
+            assume_tensor_aligned(mOut),
+            data_page_stride,
+            data_head_stride,
+            data_row_stride,
+            scale_page_stride,
+            scale_head_stride,
+        ).launch(
+            grid=(total_tasks, 1, 1),
+            block=(self.threads, 1, 1),
+            stream=stream,
+        )
+
+    @cute.kernel
+    def kernel(
+        self,
+        mData: cute.Tensor,
+        mScale: cute.Tensor,
+        mQ2k: cute.Tensor,
+        mQBatchRow: cute.Tensor,
+        mPageTable: cute.Tensor,
+        mOut: cute.Tensor,
+        data_page_stride: Int64,
+        data_head_stride: Int64,
+        data_row_stride: Int64,
+        scale_page_stride: Int64,
+        scale_head_stride: Int64,
+    ) -> None:
+        tidx = cute.arch.thread_idx()[0]
+        linear_task = cute.arch.block_idx()[0]
+        topk = Int32(mQ2k.shape[2])
+        head_kv = Int32(mQ2k.shape[1])
+        slot = linear_task % topk
+        token_head = linear_task // topk
+        head = token_head % head_kv
+        token = token_head // head_kv
+        logical_page = mQ2k[token, head, slot]
+        safe_logical_page = logical_page if logical_page >= Int32(0) else Int32(0)
+        request = mQBatchRow[token]
+        physical_page = mPageTable[request, safe_logical_page]
+        compact_page = token * topk + slot
+
+        # One conversion task covers 32 values (16 packed bytes and two scale
+        # factors). A P128/D128 page has 512 such tasks, so 256 threads each
+        # execute two. Invalid q2k entries are still staged from safe page 0;
+        # the consumer masks them from their original negative logical ID.
+        pair_task = tidx
+        while pair_task < Int32(self.page_size * (self.head_dim // 32)):
+            row = pair_task // Int32(self.head_dim // 32)
+            pair_col = pair_task - row * Int32(self.head_dim // 32)
+            packed_byte_col = pair_col * Int32(16)
+            scale_col = pair_col * Int32(2)
+
+            data_offset = (
+                Int64(physical_page) * data_page_stride
+                + Int64(head) * data_head_stride
+                + Int64(row) * data_row_stride
+                + Int64(packed_byte_col)
+            )
+            src_ptr = cute.make_ptr(
+                cutlass.Int32,
+                mData.iterator.toint() + Int64(data_offset),
+                cute.AddressSpace.gmem,
+                assumed_align=16,
+            )
+            src = cute.make_tensor(src_ptr, cute.make_layout((4,)))
+            words = cute.make_rmem_tensor((4,), cutlass.Int32)
+            copy128 = cute.make_copy_atom(
+                cute.nvgpu.CopyUniversalOp(),
+                cutlass.Int32,
+                num_bits_per_copy=128,
+            )
+            cute.copy(copy128, src, words)
+
+            scale_region = (
+                Int64(physical_page) * scale_page_stride
+                + Int64(head) * scale_head_stride
+            )
+            if const_expr(self.is_v):
+                scale_lo = self._load_scale_e4m3_u8_swizzle4x4(
+                    mScale, scale_region, row, scale_col
+                )
+                scale_hi = self._load_scale_e4m3_u8_swizzle4x4(
+                    mScale, scale_region, row, scale_col + Int32(1)
+                )
+            else:
+                scale_lo = self._load_scale_e4m3_u8_linear(
+                    mScale, scale_region, row, scale_col
+                )
+                scale_hi = self._load_scale_e4m3_u8_linear(
+                    mScale, scale_region, row, scale_col + Int32(1)
+                )
+
+            values = cute.make_rmem_tensor((32,), cutlass.Float8E4M3FN)
+            self._dequant_fp4x32_to_fp8(words, scale_lo, scale_hi, values)
+            values_i32 = cute.recast_tensor(values, cutlass.Int32)
+            out_offset = (
+                ((compact_page * head_kv + head) * Int32(self.page_size) + row)
+                * Int32(self.head_dim)
+                + pair_col * Int32(32)
+            )
+            dst_ptr = cute.make_ptr(
+                cutlass.Int32,
+                mOut.iterator.toint() + Int64(out_offset),
+                cute.AddressSpace.gmem,
+                assumed_align=16,
+            )
+            dst = cute.make_tensor(dst_ptr, cute.make_layout((8,)))
+            for word in cutlass.range_constexpr(8):
+                dst[word] = values_i32[word]
+            pair_task += Int32(self.threads)
+
+
+_compile_cache: dict[tuple[object, ...], object] = {}
+
+
+def stage_selected_nvfp4_to_fp8(
+    data: torch.Tensor,
+    scale: torch.Tensor,
+    q2k: torch.Tensor,
+    q_batch_row: torch.Tensor,
+    page_table: torch.Tensor,
+    out: torch.Tensor,
+    *,
+    is_v: bool,
+) -> None:
+    """Stage token-major selected packed NVFP4 pages into ``out`` FP8."""
+
+    if data.dtype != torch.uint8 or scale.dtype != torch.uint8:
+        raise TypeError("selected NVFP4 staging requires uint8 data and scale tensors")
+    if q2k.dtype != torch.int32 or q2k.ndim != 3 or not q2k.is_contiguous():
+        raise ValueError("q2k must be contiguous int32 [total_q, Hkv, topK]")
+    if q_batch_row.dtype != torch.int32 or q_batch_row.shape != (q2k.shape[0],):
+        raise ValueError("q_batch_row must be int32 [total_q]")
+    if page_table.dtype != torch.int32 or page_table.ndim != 2:
+        raise ValueError("page_table must be int32 [batch, max_pages]")
+    total_q, head_kv, topk = (int(d) for d in q2k.shape)
+    if data.ndim != 4 or scale.ndim != 4:
+        raise ValueError("NVFP4 data and scale tensors must be paged HND rank-4 tensors")
+    num_pages, data_heads, page_size, packed_dim = (int(d) for d in data.shape)
+    if data_heads != head_kv or packed_dim * 2 != 128:
+        raise ValueError(
+            f"expected packed NVFP4 [pages, {head_kv}, P, 64], got {tuple(data.shape)}"
+        )
+    if tuple(scale.shape) != (num_pages, head_kv, page_size, 8):
+        raise ValueError(
+            f"expected NVFP4 scales {(num_pages, head_kv, page_size, 8)}, "
+            f"got {tuple(scale.shape)}"
+        )
+    if data.stride(-1) != 1 or scale.stride(-1) != 1:
+        raise ValueError("NVFP4 staging requires unit packed-data and scale inner strides")
+    expected_out = (total_q * topk, head_kv, page_size, 128)
+    if (
+        out.dtype != torch.float8_e4m3fn
+        or tuple(out.shape) != expected_out
+        or not out.is_contiguous()
+    ):
+        raise ValueError(f"out must be contiguous FP8 with shape {expected_out}")
+    device = data.device
+    if any(t.device != device for t in (scale, q2k, q_batch_row, page_table, out)):
+        raise ValueError("all selected NVFP4 staging tensors must share one CUDA device")
+
+    key = (
+        "selected_nvfp4_to_fp8_v_sm100" if is_v else "selected_nvfp4_to_fp8_k_sm100",
+        128,
+        head_kv,
+        page_size,
+        topk,
+    )
+    if key not in _compile_cache:
+        from src.common.aot_cache import try_load_aot
+
+        loaded = try_load_aot(key)
+        if loaded is not None:
+            _compile_cache[key] = loaded
+
+    if key not in _compile_cache:
+        from quack.compile_utils import make_fake_tensor
+        from src.common.aot_cache import save_aot
+
+        pages = cute.sym_int64()
+        query_tokens = cute.sym_int64()
+        batch = cute.sym_int64()
+        max_pages = cute.sym_int64()
+        compact_pages = cute.sym_int64()
+        kernel = SelectedNvfp4ToFp8Sm100(
+            is_v=bool(is_v),
+            head_dim=128,
+            num_kv_heads=head_kv,
+            page_size=page_size,
+            topk=topk,
+        )
+        _compile_cache[key] = cute.compile(
+            kernel,
+            make_fake_tensor(
+                cutlass.Uint8,
+                (pages, head_kv, page_size, 64),
+                divisibility=16,
+            ),
+            make_fake_tensor(
+                cutlass.Uint8,
+                (pages, head_kv, page_size, 8),
+                divisibility=1,
+            ),
+            make_fake_tensor(
+                Int32,
+                (query_tokens, head_kv, topk),
+                divisibility=1,
+                leading_dim=2,
+            ),
+            make_fake_tensor(
+                Int32,
+                (query_tokens,),
+                divisibility=1,
+                leading_dim=0,
+            ),
+            make_fake_tensor(
+                Int32,
+                (batch, max_pages),
+                divisibility=1,
+                leading_dim=1,
+            ),
+            make_fake_tensor(
+                cutlass.Float8E4M3FN,
+                (compact_pages, head_kv, page_size, 128),
+                divisibility=16,
+            ),
+            Int64(0),
+            Int64(0),
+            Int64(0),
+            Int64(0),
+            Int64(0),
+            cute.runtime.make_fake_stream(use_tvm_ffi_env_stream=True),
+            options="--enable-tvm-ffi",
+        )
+        save_aot(key, _compile_cache[key])
+    _compile_cache[key](
+        data,
+        scale,
+        q2k,
+        q_batch_row,
+        page_table,
+        out,
+        int(data.stride(0)),
+        int(data.stride(1)),
+        int(data.stride(2)),
+        int(scale.stride(0)),
+        int(scale.stride(1)),
+    )
+
+
+__all__ = ["SelectedNvfp4ToFp8Sm100", "stage_selected_nvfp4_to_fp8"]
