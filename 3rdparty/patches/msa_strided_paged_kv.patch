+    # --- sharp gate: bit-equality against the captured baseline ------------
+    tag = f"{'paged' if paged else 'flat'}_{variant}"
+    golden_path = Path(os.environ.get(NVFP4_GOLDEN_ENV) or nvfp4_golden_default_path())
+    if not golden_path.is_file():
