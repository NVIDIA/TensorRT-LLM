+    aligned_for_tma = (
+        tensor.data_ptr() % alignment_bytes == 0
+        and tensor.stride(0) * tensor.element_size() % alignment_bytes == 0
+    )
+    return tensor if packed_within_page and aligned_for_tma else tensor.contiguous()
