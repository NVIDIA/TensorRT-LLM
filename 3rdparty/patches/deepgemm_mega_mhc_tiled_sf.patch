         return (grid_idx + 1) * kNumSplitBarriers * kNumMaxSplits + num_arrived_splits;
     }
 
+    // Poll with relaxed loads and back off between polls (an acquire load per poll would invalidate L1), then acquire
+    // once the barrier has completed.
+    template <typename is_done_t>
+    static CUTLASS_DEVICE void poll_then_acquire(const uint64_t* split_barrier_ptr, const is_done_t& is_done) {
+        while (true) {
+            uint64_t state;
+            asm volatile("ld.relaxed.gpu.global.u64 %0, [%1];" : "=l"(state) : "l"(split_barrier_ptr) : "memory");
