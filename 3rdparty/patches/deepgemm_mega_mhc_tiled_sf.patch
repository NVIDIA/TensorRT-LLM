+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cute/arch/cluster_sm90.hpp>
+#include <cutlass/arch/reg_reconfig.h>
+
+#include <deep_gemm/common/math.cuh>
+#include <deep_gemm/layout/mega_mhc_tmem.cuh>
+#include <deep_gemm/epilogue/sm100_mega_mhc.cuh>
+#include <deep_gemm/ptx/ld_st.cuh>
+#include <deep_gemm/scheduler/mega_mhc_tmem.cuh>
+
+namespace deep_gemm::epilogue::mega_mhc_tmem {
+
+using namespace layout::mega_mhc_tmem;
+using SharedStorage = layout::mega_mhc_tmem::SharedStorage;
+
+// Reduce one token's split partials and produce its Mix coefficients.
+template <uint32_t kHidden, bool kIsShifted, uint32_t kNumSplits>
+CUTLASS_DEVICE float run_mix_task(const Workspace<kNumSplits>& workspace, uint64_t* gmem_split_barriers,
+                                  const MixArgs& mix_args,
+                                  const uint32_t& token_idx, const uint32_t& lane_idx) {
+    const uint32_t m_block_idx = token_idx / BLOCK_M;
+    const uint32_t row_idx = token_idx % BLOCK_M;
+    sched::mega_mhc_tmem::Mix::wait<kNumSplits>(gmem_split_barriers, m_block_idx);
+
+    // Reduce HC norm statistics and GEMM outputs across the split tasks.
+    const bool is_hc_output_lane = lane_idx < kNumHCOutputs;
+    const uint32_t first_task_idx = m_block_idx * kNumSplits;
+    const auto hc_norm_sqr_sum_partials = workspace.get_hc_norm_sqr_sum_partial_ptr(first_task_idx);
+    float hc_norm_sqr_sum = 0.0f;
+    #pragma unroll
+    for (uint32_t k_split_idx = lane_idx; k_split_idx < kNumSplits; k_split_idx += 32)
+        hc_norm_sqr_sum += hc_norm_sqr_sum_partials[
+            k_split_idx * kNumSqrSumPartialElementsPerTask + row_idx];
+    hc_norm_sqr_sum = math::warp_reduce_sum(hc_norm_sqr_sum);
+
+    const uint32_t safe_hc_output_idx = cute::min(lane_idx, kNumHCOutputs - 1);
+    const auto gemm_partials = workspace.get_gemm_partial_ptr(first_task_idx);
+    float hc_output = 0.0f;
+    #pragma unroll
+    for (uint32_t k_split_idx = 0; k_split_idx < kNumSplits; ++ k_split_idx)
+        hc_output += gemm_partials[k_split_idx * kNumGemmPartialElementsPerTask +
+                                   row_idx * kNumHCOutputs + safe_hc_output_idx];
+    hc_output = is_hc_output_lane ? hc_output : 0.0f;
+    const float hc_rms_scale = rsqrtf(hc_norm_sqr_sum * (1.0f / static_cast<float>(kNumRoutes * kHidden)) + mix_args.hc_norm_eps);
+
+    // Warp lanes map to [Pre routes | Post routes | Comb routes x routes | inactive].
+    constexpr uint32_t kFirstCombLane = 2 * kNumRoutes;
+    const bool is_pre_lane = lane_idx < kNumRoutes;
+    const bool is_pre_or_post_lane = lane_idx < kFirstCombLane;
+    const bool is_comb_lane = is_hc_output_lane and not is_pre_or_post_lane;
+    float mix_value = 0.0f;
+    if (is_hc_output_lane) {
+        const uint32_t mix_scale_idx = is_pre_lane ? 0u : is_pre_or_post_lane ? 1u : 2u;
+        const float affine_value = hc_output * hc_rms_scale * mix_args.scales[mix_scale_idx] + mix_args.bases[lane_idx];
+        if (is_pre_or_post_lane) {
+            const float sigmoid = math::fast_rcp(1.0f + __expf(-affine_value));
+            mix_value = is_pre_lane ? sigmoid + mix_args.hc_pre_eps : sigmoid * mix_args.hc_post_scale;
+        } else {
+            mix_value = affine_value;
+        }
+    }
+    __syncwarp();
+
+    if constexpr (kIsShifted) {
+        // Shifted Mix warps are dedicated: every lane normalizes the whole comb matrix in registers, so no Sinkhorn step
+        // waits on a shuffle. Row and column sums keep the order of the lane butterflies: (x0 + x2) + (x1 + x3) per row,
+        // (x0 + x1) + (x2 + x3) per column. Normal runs the Mix on each token's critical path beside five other workers,
+        // where fewer instructions win: each comb lane normalizes its own element.
+        DG_STATIC_ASSERT(kNumRoutes == 4, "The Sinkhorn sums are written for four routes");
+        float comb[kNumRoutes][kNumRoutes];
+        #pragma unroll
+        for (uint32_t i = 0; i < kNumRoutes * kNumRoutes; ++ i)
+            comb[i / kNumRoutes][i % kNumRoutes] = __shfl_sync(0xffffffff, mix_value, kFirstCombLane + i);
+        const auto get_row_sum = [&](const uint32_t& r) { return (comb[r][0] + comb[r][2]) + (comb[r][1] + comb[r][3]); };
+        const auto get_col_sum = [&](const uint32_t& c) { return (comb[0][c] + comb[1][c]) + (comb[2][c] + comb[3][c]); };
+        const auto normalize_cols = [&]() {
+            #pragma unroll
+            for (uint32_t c = 0; c < kNumRoutes; ++ c) {
+                const float scale = math::fast_rcp(get_col_sum(c) + mix_args.sinkhorn_eps);
+                #pragma unroll
+                for (uint32_t r = 0; r < kNumRoutes; ++ r)
+                    comb[r][c] *= scale;
+            }
+        };
+        #pragma unroll
+        for (uint32_t r = 0; r < kNumRoutes; ++ r) {
+            const float row_max = fmaxf(fmaxf(comb[r][0], comb[r][2]), fmaxf(comb[r][1], comb[r][3]));
+            #pragma unroll
+            for (uint32_t c = 0; c < kNumRoutes; ++ c)
+                comb[r][c] = __expf(comb[r][c] - row_max);
+            const float scale = math::fast_rcp(get_row_sum(r));
+            #pragma unroll
+            for (uint32_t c = 0; c < kNumRoutes; ++ c)
+                comb[r][c] = comb[r][c] * scale + mix_args.sinkhorn_eps;
+        }
+        normalize_cols();
+        #pragma unroll 1
+        for (uint32_t iteration = 1; iteration < mix_args.num_sinkhorn_iters; ++ iteration) {
+            #pragma unroll
+            for (uint32_t r = 0; r < kNumRoutes; ++ r) {
+                const float scale = math::fast_rcp(get_row_sum(r) + mix_args.sinkhorn_eps);
+                #pragma unroll
+                for (uint32_t c = 0; c < kNumRoutes; ++ c)
+                    comb[r][c] *= scale;
+            }
+            normalize_cols();
+        }
+
+        if (is_pre_or_post_lane) {
+            float* mix_output = is_pre_lane ? mix_args.new_prev_mix : mix_args.new_post_mix;
+            mix_output[token_idx * kNumRoutes + (lane_idx & (kNumRoutes - 1))] = mix_value;
+        }
+        if (lane_idx == 0) {
+            const auto comb_output = reinterpret_cast<float4*>(mix_args.new_comb_res_mix + token_idx * kNumRoutes * kNumRoutes);
+            #pragma unroll
+            for (uint32_t r = 0; r < kNumRoutes; ++ r)
+                comb_output[r] = make_float4(comb[r][0], comb[r][1], comb[r][2], comb[r][3]);
+        }
+    } else {
+        const auto sinkhorn_normalize = [&](float value) {
+            // Comb logits occupy a row-major route x route region after Pre and Post.
+            value = is_comb_lane ? value : 0.0f;
+            const float row_max = math::warp_reduce_max<kNumRoutes>(value);
+            value = __expf(value - row_max);
+            float row_sum = math::warp_reduce_sum<kNumRoutes>(value);
+            value = value * math::fast_rcp(row_sum) + mix_args.sinkhorn_eps;
+
+            const auto get_col_sum = [](const float& element) {
+                // For four routes, these XORs combine adjacent rows, then the two row pairs.
+                float sum = element + __shfl_xor_sync(0xffffffff, element, kNumRoutes);
+                sum += __shfl_xor_sync(0xffffffff, sum, 6 * kNumRoutes);
+                return sum;
+            };
+
+            value *= math::fast_rcp(get_col_sum(value) + mix_args.sinkhorn_eps);
+            #pragma unroll 1
+            for (uint32_t iteration = 1; iteration < mix_args.num_sinkhorn_iters; ++ iteration) {
+                row_sum = math::warp_reduce_sum<kNumRoutes>(value);
+                value *= math::fast_rcp(row_sum + mix_args.sinkhorn_eps);
+                value *= math::fast_rcp(get_col_sum(value) + mix_args.sinkhorn_eps);
+            }
+            return value;
+        };
+
+        const float normalized_comb = sinkhorn_normalize(mix_value);
+
+        // Only Shifted stores the new Pre coefficients.
+        if (is_hc_output_lane and (kIsShifted or not is_pre_lane)) {
+            float* mix_output = is_pre_lane ? mix_args.new_prev_mix :
+                                is_comb_lane ? mix_args.new_comb_res_mix : mix_args.new_post_mix;
+            const uint32_t mix_output_stride = is_comb_lane ? kNumRoutes * kNumRoutes : kNumRoutes;
+            const uint32_t mix_output_idx = is_comb_lane ? lane_idx - kFirstCombLane : lane_idx & (kNumRoutes - 1);
+            mix_output[token_idx * mix_output_stride + mix_output_idx] = is_comb_lane ? normalized_comb : mix_value;
+        }
+    }
+    __syncwarp();
+
+    return mix_value;
+}
+
+// Shifted Mix workers share one CTA task queue. Tickets keep the CTA's token set and their m-block order: ticket t
+// takes the (t / 4)-th grid stride of token residue t % 4.
+template <uint32_t kHidden, uint32_t kNumSMs, uint32_t kNumSplits>
+CUTLASS_DEVICE void run_shifted_mix_worker(SharedStorage& smem, const Workspace<kNumSplits>& workspace,
+                                           uint64_t* gmem_split_barriers, const MixArgs& mix_args,
+                                           const uint32_t& num_tokens, const uint32_t& lane_idx) {
+    while (true) {
+        uint32_t task_ticket;
+        if (cute::elect_one_sync())
+            task_ticket = atomicAdd(&smem.next_mix_task_ticket, 1u);
+        task_ticket = ptx::exchange(task_ticket, 0);
+        const uint32_t token_idx = blockIdx.x * kNumWarpsPerWG + task_ticket % kNumWarpsPerWG +
+                                   task_ticket / kNumWarpsPerWG * (kNumSMs * kNumWarpsPerWG);
+        if (token_idx >= num_tokens)
+            return;
+        run_mix_task<kHidden, true>(workspace, gmem_split_barriers, mix_args, token_idx, lane_idx);
+    }
+}
+
+using epilogue::mega_mhc::kNumBF16PairsPerLane;
+using epilogue::mega_mhc::normalize_bf16_pair;
+using epilogue::mega_mhc::get_sf_exp;
+using epilogue::mega_mhc::get_shared_sf_row_idx;
+using epilogue::mega_mhc::run_normal_worker;
+
+// Shifted X1 buffer 0 takes the upper 16 lanes of each lane quadrant, which the M = 64 MMA leaves unused; buffer 1
+// starts after the accumulators.
+template <uint32_t kX1TmemStartColumn>
+CUTLASS_DEVICE uint32_t get_x1_tmem_offset(const uint32_t& buffer_idx) {
+    return buffer_idx == 0 ? (16u << 16) : kX1TmemStartColumn;
+}
+
+// Shifted Norm: the CTA that produced a task's X1 normalizes it from tensor memory once the m-block's X1 statistics
+// complete. WG5 (worker 0) drains every task's buffer in order; on the CTA's last task the two retired Post workers
+// take every third K block as well. Each thread owns one row of its warp's lane quadrant and, per K block, one
+// 32-element SF group: tensor memory holds a row's hidden pairs in consecutive columns.
+template <uint32_t kHidden, uint32_t kNumSMs, uint32_t kNumRegisters, bool kStoreBF16, bool kStoreFP8,
+          uint32_t SF_BLOCK_M, uint32_t kX1TmemStartColumn, uint32_t kNumSplits>
+CUTLASS_DEVICE void run_shifted_norm_worker(SharedStorage& smem, const Workspace<kNumSplits>& workspace,
+                                            uint64_t* gmem_split_barriers, const NormArgs& norm_args,
+                                            const uint32_t& tmem_base, const uint32_t& num_tasks,
+                                            const uint32_t& worker_idx, const uint32_t& warp_idx_in_wg,
+                                            const uint32_t& lane_idx) {
+    constexpr uint32_t kNumWorkers = 3;
+    constexpr uint32_t kNumKBlocksPerSplit = kHidden / BLOCK_K / kNumSplits;
+    constexpr uint32_t kNumLongSplits = kHidden / BLOCK_K % kNumSplits;
+    constexpr uint32_t kNumX1TmemColumnsPerKBlock = BLOCK_K / 2;
+    constexpr uint32_t kNumRowsPerWarp = BLOCK_M / kNumWarpsPerWG;
+    constexpr uint32_t kNumPacksPerGroup = kHiddenPerSF / (2 * kNumBF16PairsPerLane);
+    DG_STATIC_ASSERT(BLOCK_K == 2 * kHiddenPerSF and kNumRowsPerWarp == 16, "One K block is two SF groups of 16 rows");
+    if (blockIdx.x >= num_tasks)
+        return;
+
+    cutlass::arch::warpgroup_reg_alloc<kNumRegisters>();
+    const uint32_t num_cta_tasks = math::ceil_div(num_tasks - blockIdx.x, kNumSMs);
+    const uint32_t row_idx = warp_idx_in_wg * kNumRowsPerWarp + lane_idx % kNumRowsPerWarp;
+    const uint32_t group_idx_in_k_block = lane_idx / kNumRowsPerWarp;
+    for (uint32_t cta_task_idx = worker_idx == 0 ? 0 : num_cta_tasks - 1; cta_task_idx < num_cta_tasks; ++ cta_task_idx) {
+        const uint32_t task_idx = blockIdx.x + cta_task_idx * kNumSMs;
+        const uint32_t split_idx = task_idx % kNumSplits;
+        const uint32_t m_block_idx = task_idx / kNumSplits;
+        const uint32_t num_task_k_blocks = kNumKBlocksPerSplit + (split_idx < kNumLongSplits);
+        const uint32_t task_k_begin = split_idx * (kNumKBlocksPerSplit * BLOCK_K) + cute::min(split_idx, kNumLongSplits) * BLOCK_K;
+        const uint32_t buffer_idx = cta_task_idx % kNumX1Buffers;
+        const bool is_last_task = cta_task_idx + 1 == num_cta_tasks;
+
+        const uint32_t first_k_block_idx = is_last_task ? worker_idx : 0;
+        const uint32_t k_block_step = is_last_task ? kNumWorkers : 1;
+        const auto get_hidden_idx = [&](const uint32_t& k_block_idx) {
+            return task_k_begin + k_block_idx * BLOCK_K + group_idx_in_k_block * kHiddenPerSF;
+        };
+        // Weights stream one K block ahead, the first ones while the m-block's statistics complete
+        const auto load_weights = [&](const uint32_t& k_block_idx, uint4 (&weights)[kNumPacksPerGroup]) {
+            const auto weight_packs = reinterpret_cast<const uint4*>(norm_args.weight + get_hidden_idx(k_block_idx));
+            #pragma unroll
+            for (uint32_t pack_idx = 0; pack_idx < kNumPacksPerGroup; ++ pack_idx)
+                weights[pack_idx] = weight_packs[pack_idx];
+        };
+        uint4 weights[kNumPacksPerGroup];
+        if (first_k_block_idx < num_task_k_blocks)
+            load_weights(first_k_block_idx, weights);
+
+        // Wait for the task's X1 columns, then its m-block's split statistics
+        smem.full_x1_barriers[buffer_idx].wait((cta_task_idx / kNumX1Buffers) & 1);
+        ptx::tcgen05_after_thread_sync();
+        sched::mega_mhc_tmem::Norm::wait<kNumSplits>(gmem_split_barriers, m_block_idx);
+
+        const uint32_t token_idx = m_block_idx * BLOCK_M + row_idx;
+        const bool is_valid_token = token_idx < norm_args.num_tokens;
+        float rms_scale = 0.0f;
+        if (is_valid_token) {
+            const auto x1_sqr_sum_partials = workspace.get_x1_sqr_sum_partial_ptr(m_block_idx * kNumSplits);
+            float x1_sqr_sum = 0.0f;
+            #pragma unroll
+            for (uint32_t k_split_idx = 0; k_split_idx < kNumSplits; ++ k_split_idx)
+                x1_sqr_sum += x1_sqr_sum_partials[k_split_idx * kNumSqrSumPartialElementsPerTask + row_idx];
+            constexpr float kInvHidden = 1.0f / static_cast<float>(kHidden);
+            rms_scale = rsqrtf(x1_sqr_sum * kInvHidden + norm_args.eps) * norm_args.scale;
+        }
+        uint32_t shared_sf_row_idx = 0;
+        if constexpr (SF_BLOCK_M > 0)
+            shared_sf_row_idx = get_shared_sf_row_idx<kHidden, SF_BLOCK_M>(token_idx);
+
+        const uint32_t x1_tmem_addr = tmem_base + get_x1_tmem_offset<kX1TmemStartColumn>(buffer_idx);
+        for (uint32_t k_block_idx = first_k_block_idx; k_block_idx < num_task_k_blocks; k_block_idx += k_block_step) {
+            // Threads 0-15 take the K block's first SF group of rows 0-15, threads 16-31 its second.
+            uint32_t x1[kHiddenPerSF / 2];
+            cute::SM100_TMEM_LOAD_16dp32b16x::copy(
+                x1_tmem_addr + k_block_idx * kNumX1TmemColumnsPerKBlock,
+                x1[0], x1[1], x1[2], x1[3], x1[4], x1[5], x1[6], x1[7],
+                x1[8], x1[9], x1[10], x1[11], x1[12], x1[13], x1[14], x1[15]);
+            cutlass::arch::fence_view_async_tmem_load();
+            const bool has_next_k_block = k_block_idx + k_block_step < num_task_k_blocks;
+            uint4 next_weights[kNumPacksPerGroup];
+            if (has_next_k_block)
+                load_weights(k_block_idx + k_block_step, next_weights);
+            if (is_valid_token) {
+                const uint32_t hidden_idx = get_hidden_idx(k_block_idx);
+                const uint64_t output_offset = static_cast<uint64_t>(token_idx) * kHidden + hidden_idx;
+                uint4 packs[kNumPacksPerGroup];
+                #pragma unroll
+                for (uint32_t pack_idx = 0; pack_idx < kNumPacksPerGroup; ++ pack_idx) {
+                    const auto weight_pairs = reinterpret_cast<const nv_bfloat162*>(&weights[pack_idx]);
+                    const auto x1_pairs = reinterpret_cast<const nv_bfloat162*>(x1 + pack_idx * kNumBF16PairsPerLane);
+                    const auto values = reinterpret_cast<nv_bfloat162*>(&packs[pack_idx]);
+                    #pragma unroll
+                    for (uint32_t pair_idx = 0; pair_idx < kNumBF16PairsPerLane; ++ pair_idx)
+                        values[pair_idx] = normalize_bf16_pair(x1_pairs[pair_idx], weight_pairs[pair_idx], rms_scale);
+                }
+                // Whole 32-byte sectors per store: a partly written sector costs L2 a DRAM fill.
+                const auto store_256 = [](void* ptr, const uint4& lo, const uint4& hi) {
+                    alignas(32) const uint4 values[2] = {lo, hi};
+                    *reinterpret_cast<ptx::longlong4_t*>(ptr) = *reinterpret_cast<const ptx::longlong4_t*>(values);
+                };
+                if constexpr (kStoreBF16) {
+                    store_256(norm_args.y_bf16 + output_offset, packs[0], packs[1]);
+                    store_256(norm_args.y_bf16 + output_offset + 16, packs[2], packs[3]);
+                }
+                if constexpr (kStoreFP8) {
+                    // The amax tree of the lane-parallel form: four 8-element packs, (0, 2) and (1, 3) first.
+                    nv_bfloat16 pack_amaxes[kNumPacksPerGroup];
+                    #pragma unroll
+                    for (uint32_t pack_idx = 0; pack_idx < kNumPacksPerGroup; ++ pack_idx)
+                        pack_amaxes[pack_idx] = math::get_packed_bf16_amax(reinterpret_cast<const nv_bfloat162(&)[4]>(packs[pack_idx]));
+                    const uint32_t sf_exp = get_sf_exp<SF_BLOCK_M>(
+                        __hmax(__hmax(pack_amaxes[0], pack_amaxes[2]), __hmax(pack_amaxes[1], pack_amaxes[3])));
+                    const auto sf_inv = __bfloat162bfloat162(math::get_ue8m0_sf_inv<nv_bfloat16>(sf_exp));
+                    uint32_t fp8_values[kNumPacksPerGroup * 2];
+                    #pragma unroll
+                    for (uint32_t pack_idx = 0; pack_idx < kNumPacksPerGroup; ++ pack_idx) {
+                        const auto bf16x2 = reinterpret_cast<const nv_bfloat162*>(&packs[pack_idx]);
+                        fp8_values[pack_idx * 2] = math::scale_bf16x2_into_fp8x4(bf16x2[0], bf16x2[1], sf_inv, sf_inv);
+                        fp8_values[pack_idx * 2 + 1] = math::scale_bf16x2_into_fp8x4(bf16x2[2], bf16x2[3], sf_inv, sf_inv);
+                    }
+                    store_256(norm_args.y_fp8 + output_offset, make_uint4(fp8_values[0], fp8_values[1], fp8_values[2], fp8_values[3]),
+                              make_uint4(fp8_values[4], fp8_values[5], fp8_values[6], fp8_values[7]));
+
+                    // Byte k of a packed SF word is its k-th 32-element group.
+                    const uint32_t sf_word_idx = hidden_idx / kHiddenPerSFWord;
+                    const uint32_t sf_byte_idx = hidden_idx / kHiddenPerSF % (kHiddenPerSFWord / kHiddenPerSF);
+                    if constexpr (SF_BLOCK_M != kTiledSFBlockM)
+                        reinterpret_cast<uint8_t*>(norm_args.y_primary_sf + token_idx * norm_args.y_primary_sf_stride_token +
+                                                   sf_word_idx * norm_args.y_primary_sf_stride_word)[sf_byte_idx] = sf_exp;
+                    if constexpr (SF_BLOCK_M > 0)
+                        reinterpret_cast<uint8_t*>(norm_args.y_shared_sf + static_cast<int64_t>(sf_word_idx) * norm_args.y_shared_sf_stride_word +
+                                                   shared_sf_row_idx)[sf_byte_idx] = sf_exp;
+                }
+            }
+            if (has_next_k_block) {
+                #pragma unroll
+                for (uint32_t pack_idx = 0; pack_idx < kNumPacksPerGroup; ++ pack_idx)
+                    weights[pack_idx] = next_weights[pack_idx];
+            }
+        }
+
+        // Hand the buffer to the task two ahead; nothing follows the last task.
+        if (worker_idx == 0 and not is_last_task) {
+            ptx::tcgen05_before_thread_sync();
+            __syncwarp();
+            if (cute::elect_one_sync())
+                smem.empty_x1_barriers[buffer_idx].arrive();
+        }
+    }
+}
+
+} // namespace deep_gemm::epilogue::mega_mhc_tmem
