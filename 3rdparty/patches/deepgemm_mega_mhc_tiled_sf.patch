+// A ring whose stage count is set at run time.
+struct RuntimeRingPipeline {
+    uint32_t num_stages, stage_idx = 0, phase = 0;
+
+    CUTLASS_DEVICE explicit RuntimeRingPipeline(const uint32_t& num_stages): num_stages(num_stages) {}
