+// The tiled SF output follows TensorRT-LLM's MXFP8 rule: the exact UE8M0 ceiling of amax / 448 without
+// the 2 ^ -22 floor, so all-zero blocks get 0.
 template <uint32_t SF_BLOCK_M>
+CUTLASS_DEVICE uint32_t get_sf_exp(const nv_bfloat16& amax) {
+    if constexpr (SF_BLOCK_M == kTiledSFBlockM) {
+        const uint32_t rounded_exp = (static_cast<uint32_t>(__bfloat16_as_ushort(amax)) + 0x1fu) >> 7;
+        return rounded_exp > 8u ? rounded_exp - 8u : 0u;
+    } else {
+        return math::get_ue8m0_sf_exp(amax);
+    }
+}
+
+template <uint32_t kHidden, uint32_t SF_BLOCK_M>
 CUTLASS_DEVICE uint32_t get_shared_sf_row_idx(const uint32_t& token_idx) {
-    // Mega MoE SF pages interleave four 32-row groups within each 128-row page.
-    const uint32_t idx = token_idx % SF_BLOCK_M;
-    return token_idx / SF_BLOCK_M * ((SF_BLOCK_M + 127u) & ~127u) +
-           (idx & ~127u) + (idx & 31u) * 4 + ((idx >> 5) & 3u);
+    if constexpr (SF_BLOCK_M == kTiledSFBlockM) {
+        // 128-row tiles of 128 words per SF word column (word stride 128), each interleaving
+        // four 32-row groups.
+        return token_idx / 128u * (kHidden / kHiddenPerSFWord * 128u) +
+               (token_idx & 31u) * 4 + ((token_idx >> 5) & 3u);
+    } else {
+        // Mega MoE SF pages interleave four 32-row groups within each 128-row page.
+        const uint32_t idx = token_idx % SF_BLOCK_M;
+        return token_idx / SF_BLOCK_M * ((SF_BLOCK_M + 127u) & ~127u) +
+               (idx & ~127u) + (idx & 31u) * 4 + ((idx >> 5) & 3u);
+    }
 }
 
