+// Shifted Mix workers share one CTA task queue. Tickets keep the CTA's token set and their m-block order: ticket t
+// takes the (t / 4)-th grid stride of token residue t % 4.
+template <uint32_t kHidden, uint32_t kNumSMs, uint32_t kNumSplits>
+CUTLASS_DEVICE void run_shifted_mix_worker(SharedStorage& smem, const Workspace<kNumSplits>& workspace,
+                                           uint64_t* gmem_split_barriers, const MixArgs& mix_args,
+                                           const uint32_t& num_tokens, const uint32_t& lane_idx) {
+    while (true) {
+        uint32_t task_ticket;
+        if (cute::elect_one_sync())
+            task_ticket = atomicAdd(&smem.next_mix_task_ticket, 1u);
+        task_ticket = ptx::exchange(task_ticket, 0);
+        const uint32_t token_idx = blockIdx.x * kNumWarpsPerWG + task_ticket % kNumWarpsPerWG +
+                                   task_ticket / kNumWarpsPerWG * (kNumSMs * kNumWarpsPerWG);
+        if (token_idx >= num_tokens)
+            return;
+        // While the CTA streams, the lane-parallel Sinkhorn issues fewer instructions; afterwards the
+        // register one has the shorter chain.
+        if (*reinterpret_cast<volatile uint32_t*>(&smem.streaming_done))
+            run_mix_task<kHidden, true, kNumSplits, true>(workspace, gmem_split_barriers, mix_args, token_idx, lane_idx);
+        else
+            run_mix_task<kHidden, true, kNumSplits, false>(workspace, gmem_split_barriers, mix_args, token_idx, lane_idx);
+    }
+}
