+          py::arg("a_dtype"), py::arg("b_dtype"), py::arg("d_dtype"),
+          py::arg("recipe") = std::make_tuple(1, 1, 128),
+          py::arg("with_accumulation") = false,
+          py::arg("compiled_dims") = "nk",
+          py::call_guard<py::gil_scoped_release>());
+    m.def("compile_only_m_grouped_fp8_fp4_gemm_nt_masked", &compile_only_m_grouped_fp8_fp4_gemm_nt_masked,
+          py::arg("num_groups"), py::arg("m"), py::arg("n"), py::arg("k"), py::arg("expected_m"),
+          py::arg("a_dtype"), py::arg("b_dtype"),
+          py::arg("recipe") = std::make_tuple(1, 1, 128),
+          py::arg("compiled_dims") = "nk",
+          py::call_guard<py::gil_scoped_release>());
 
