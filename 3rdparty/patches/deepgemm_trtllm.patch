+// up, without loading or launching it. Returns true if it compiled, false if
+// the kernel was already cached. With `DJ_COMPILE_TARGET` set, this needs no
+// visible GPU (see deep_jit::cuda::Device::get_prop).
+inline bool compile_only_source(const std::string& tag, const std::string& source) {
+    const auto& options = jit->default_compiler_options;
+    const auto key = jit->cache_key(source, options);
+    auto entry = jit->disk_cache.entry(tag, key);
+    if (entry.hit)
+        return false;
+    jit->backend.compile(source, entry.path, jit->env, jit->config, options);
+    entry.commit();
+    return true;
+}
