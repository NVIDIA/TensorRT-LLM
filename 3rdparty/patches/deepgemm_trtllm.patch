+// Compile, without launching or loading, the SM100 FP8/FP4 1D1D kernel that
+// `fp8_fp4_gemm_nt` would run for an [m, k] x [n, k]^T GEMM. Covers the
+// arch-10 path of `fp8_fp4_gemm_nt` with int (UE8M0) scaling factors and
+// K-major A and B, which is how TensorRT-LLM calls it. Returns True if it
+// compiled, False if the variant was already in the cache.
+static bool compile_only_m_grouped_fp8_fp4_gemm_nt_masked(const int& num_groups, const int& m,
+                                                          const int& n, const int& k,
+                                                          const int& expected_m,
+                                                          const at::ScalarType& a_dtype,
+                                                          const at::ScalarType& b_dtype,
+                                                          const std::tuple<int, int, int>& recipe,
+                                                          const std::string& compiled_dims) {
+    DG_HOST_ASSERT(device_runtime->get_arch_major() == 10 and "compile-only is implemented for SM100 only");
+    DG_HOST_ASSERT(expected_m > 0 and m > 0 and n > 0 and k > 0 and num_groups > 0);
+    const auto gran_k = std::get<2>(recipe);
+    return sm100_m_grouped_fp8_fp4_gemm_masked_1d1d_compile_only(num_groups, m, n, k, expected_m,
+                                                                 a_dtype, b_dtype, torch::kBFloat16,
+                                                                 gran_k, gran_k,
+                                                                 cute::UMMA::Major::K, cute::UMMA::Major::K,
+                                                                 compiled_dims);
+}
+
+static bool compile_only_fp8_fp4_gemm_nt(const int& m, const int& n, const int& k,
+                                         const at::ScalarType& a_dtype,
+                                         const at::ScalarType& b_dtype,
+                                         const at::ScalarType& d_dtype,
+                                         const std::tuple<int, int, int>& recipe,
+                                         const bool& with_accumulation,
+                                         const std::string& compiled_dims) {
+    DG_HOST_ASSERT(device_runtime->get_arch_major() == 10 and "compile-only is implemented for SM100 only");
+    DG_HOST_ASSERT(d_dtype == torch::kBFloat16 or d_dtype == torch::kFloat);
+    if (m == 0 or n == 0 or k == 0)
+        return false;
+    const auto gran_k = std::get<2>(recipe);
+    return sm100_fp8_fp4_gemm_1d1d_compile_only(m, n, k, a_dtype, b_dtype, d_dtype,
+                                                gran_k, gran_k,
+                                                cute::UMMA::Major::K, cute::UMMA::Major::K,
+                                                with_accumulation, compiled_dims);
+}
+
 static void register_apis(pybind11::module_& m) {
+    m.def("compile_only_fp8_fp4_gemm_nt", &compile_only_fp8_fp4_gemm_nt,
