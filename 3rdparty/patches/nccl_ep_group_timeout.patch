+
+ncclResult_t ncclEpGroupGetTimeout(ncclEpGroup_t ep_group, uint64_t* timeout_ns) {
+    EP_HOST_ASSERT(ep_group != nullptr);
+    EP_HOST_ASSERT(timeout_ns != nullptr);
+    EP_HOST_ASSERT(ep_group->clock_khz > 0);
+    *timeout_ns = ep_group->timeout_cycles / ep_group->clock_khz * 1000000ULL;
+    return ncclSuccess;
+}
