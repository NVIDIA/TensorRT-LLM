+ncclResult_t ncclEpGroupSetTimeout(ncclEpGroup_t ep_group, uint64_t timeout_ns) {
+    EP_HOST_ASSERT(ep_group != nullptr);
+    EP_HOST_ASSERT(ep_group->clock_khz > 0);
+    if (timeout_ns == 0) {
+        ep_group->timeout_cycles = ep_group->creation_timeout_cycles;
+        return ncclSuccess;
