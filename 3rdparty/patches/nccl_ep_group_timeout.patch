+    const uint64_t timeout_ms = timeout_ns / 1000000ULL;
+    if (timeout_ms == 0 || timeout_ms > UINT64_MAX / ep_group->clock_khz) {
+        return ncclInvalidArgument;
+    }
+    ep_group->timeout_cycles = ep_group->clock_khz * timeout_ms;
+    return ncclSuccess;
