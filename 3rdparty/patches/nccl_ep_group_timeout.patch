+// Set the timeout of the GPU-side wait loops for subsequent launches on this group.
+//   Host-side only: each launch copies the timeout into its kernel arguments, so a
+//   launch captured into a CUDA graph keeps the timeout that was set at capture.
+//   Not thread-safe with concurrent launches on the same group.
+//
+// Arguments:
+//   ep_group   - [IN] EP group
+//   timeout_ns - [IN] Timeout in nanoseconds, at millisecond resolution.
+//                     0 restores the timeout resolved by
+//                     ncclEpCreateGroup (NCCL_EP_TIMEOUT_MS > config.timeout_ns > default).
+//
+// Returns: ncclResult_t error code; ncclInvalidArgument for a nonzero timeout below
+//   one millisecond or one that overflows the cycle count.
+
+ncclResult_t ncclEpGroupSetTimeout(ncclEpGroup_t ep_group, uint64_t timeout_ns);
+
+// Get the timeout of the GPU-side wait loops for subsequent launches on this group.
+//
+// Arguments:
+//   ep_group   - [IN]  EP group
+//   timeout_ns - [OUT] Timeout in nanoseconds, at millisecond resolution
+//
+// Returns: ncclResult_t error code
+
+ncclResult_t ncclEpGroupGetTimeout(ncclEpGroup_t ep_group, uint64_t* timeout_ns);
+
 #ifdef __cplusplus
 }
 #endif
