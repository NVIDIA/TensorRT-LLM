+ncclResult_t ncclEpGroupSetTimeout(ncclEpGroup_t ep_group, uint64_t timeout_ns) {
+    EP_HOST_ASSERT(ep_group != nullptr);
+    EP_HOST_ASSERT(ep_group->clock_khz > 0);
+    if (timeout_ns == 0) {
+        ep_group->timeout_cycles = ep_group->creation_timeout_cycles;
+        return ncclSuccess;
+    }
+    // The setter accepts millisecond-resolution timeouts.
+    const uint64_t timeout_ms = timeout_ns / 1000000ULL;
+    if (timeout_ms == 0 || timeout_ms > (UINT64_MAX / 2) / ep_group->clock_khz) {
+        return ncclInvalidArgument;
+    }
+    ep_group->timeout_cycles = ep_group->clock_khz * timeout_ms;
+    return ncclSuccess;
+}
+
+ncclResult_t ncclEpGroupGetTimeout(ncclEpGroup_t ep_group, uint64_t* timeout_ns) {
+    EP_HOST_ASSERT(ep_group != nullptr);
+    EP_HOST_ASSERT(timeout_ns != nullptr);
+    EP_HOST_ASSERT(ep_group->clock_khz > 0);
+    *timeout_ns = ep_group->timeout_cycles / ep_group->clock_khz * 1000000ULL;
+    return ncclSuccess;
+}
