# sm100_mqa_logits: compute the ReLU with fmaxf on the ALU pipe instead of (a + |a|) / 2 on the FMA pipe.
# Finite logits are bitwise identical; NaN and -inf scores now contribute 0.

diff --git a/deep_gemm/include/deep_gemm/impls/sm100_mqa_logits.cuh b/deep_gemm/include/deep_gemm/impls/sm100_mqa_logits.cuh
index fdef46d..0bcde60 100644
--- a/deep_gemm/include/deep_gemm/impls/sm100_mqa_logits.cuh
+++ b/deep_gemm/include/deep_gemm/impls/sm100_mqa_logits.cuh
@@ -489,11 +489,11 @@
                         } else {
                             auto sum_0 = make_float2(0, 0);
                             auto sum_1 = make_float2(0, 0);
+                            // ReLU with `fmaxf` runs on the ALU pipe; the weighted sum saturates the FMA pipe.
                             const auto transform = [&](const uint32_t& j, const float2& sum) {
-                                auto a_0 = make_float2(accum[j], accum[j + 1]);
-                                auto a_1 = make_float2(fabsf(accum[j]), fabsf(accum[j + 1]));
+                                auto a = make_float2(fmaxf(accum[j], 0.0f), fmaxf(accum[j + 1], 0.0f));
                                 auto b = make_float2(weights[i][j], weights[i][j + 1]);
-                                return __ffma2_rn(__fadd2_rn(a_0, a_1), b, sum);
+                                return __ffma2_rn(a, b, sum);
                             };
 
                             #pragma unroll
@@ -503,7 +503,7 @@
                             }
 
                             auto sum = __fadd2_rn(sum_0, sum_1);
-                            reduced = (sum.x + sum.y) / 2;
+                            reduced = sum.x + sum.y;
                         }
                         auto result = static_cast<logits_dtype_t>(kIsMXSF ? reduced : reduced * scale_kv);
                         const auto q_offset = scheduler.get_logits_row(q_block_idx, i) * static_cast<uint64_t>(logits_stride);
