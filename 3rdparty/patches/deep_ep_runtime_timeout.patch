 namespace deep_ep {
 
+int num_cpu_timeout_secs = DEFAULT_NUM_CPU_TIMEOUT_SECS;
+__device__ unsigned long long num_timeout_cycles = DEFAULT_NUM_TIMEOUT_CYCLES;
+
+void set_timeout_seconds(int timeout_secs) {
+    EP_HOST_ASSERT(0 <= timeout_secs and timeout_secs <= 86400);
+    const unsigned long long cycles = timeout_secs == 0 ? DEFAULT_NUM_TIMEOUT_CYCLES
+                                                        : static_cast<unsigned long long>(timeout_secs) * NUM_TIMEOUT_CYCLES_PER_SEC;
+    CUDA_CHECK(cudaMemcpyToSymbol(num_timeout_cycles, &cycles, sizeof(cycles)));
+    num_cpu_timeout_secs = timeout_secs == 0 ? DEFAULT_NUM_CPU_TIMEOUT_SECS : timeout_secs;
+}
+
+int get_timeout_seconds() {
+    unsigned long long cycles;
+    CUDA_CHECK(cudaMemcpyFromSymbol(&cycles, num_timeout_cycles, sizeof(cycles)));
+    return static_cast<int>(cycles / NUM_TIMEOUT_CYCLES_PER_SEC);
+}
+
