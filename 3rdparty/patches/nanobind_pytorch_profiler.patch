+#  error "TRTLLM_ENABLE_NANOBIND_PROFILING requires PyTorch 2.14 or newer for the private Tensor API"
+#endif
+#if defined(Py_LIMITED_API) || defined(NB_FREE_THREADED)
+#  error "TRTLLM_ENABLE_NANOBIND_PROFILING requires the CPython GIL and full Python API"
+#endif
+
+// Parse Torch/pybind11 before nb_internals.h defines its check macro.
+#include <torch/csrc/autograd/python_variable.h>
+
+namespace trtllm_pytorch_profiler {
+
+//! Check the concrete Tensor subtype hierarchy without Python callbacks or error changes.
+inline bool isTensor(PyObject *value) noexcept {
+    return value != nullptr && THPVariableClass != nullptr &&
+           PyObject_TypeCheck(value, reinterpret_cast<PyTypeObject *>(THPVariableClass));
+}
+
+//! Copy the underlying Tensor handle; guarded non-tensors produce an undefined handle.
+inline at::Tensor unpackTensor(PyObject *value) {
+    return isTensor(value) ? THPVariable_Unpack(value) : at::Tensor{};
+}
+
+} // namespace trtllm_pytorch_profiler
