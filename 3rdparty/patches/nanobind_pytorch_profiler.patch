+#if defined(TLLM_NANOBIND_PROFILING)
+// Observational Python work must not replace a pending operation exception.
+class nb_func_profiler_error_state {
+public:
+    nb_func_profiler_error_state() noexcept {
+        PyErr_Fetch(&type, &value, &traceback);
+    }
+    ~nb_func_profiler_error_state() noexcept {
+        PyErr_Clear();
+        PyErr_Restore(type, value, traceback);
+    }
+    nb_func_profiler_error_state(const nb_func_profiler_error_state &) = delete;
+    nb_func_profiler_error_state &operator=(const nb_func_profiler_error_state &) = delete;
+
+private:
+    PyObject *type = nullptr, *value = nullptr, *traceback = nullptr;
+};
+
+static std::string nb_func_profiler_utf8(PyObject *value) {
+    if (!value)
+        throw std::runtime_error("nanobind profiler name unavailable");
+    Py_ssize_t size = 0;
+    const char *data = PyUnicode_AsUTF8AndSize(value, &size);
+    if (!data)
+        throw std::runtime_error("nanobind profiler name is not UTF-8");
+    return std::string(data, (size_t) size);
+}
+
+static std::string nb_func_profiler_name(PyObject *self) {
+    const func_data *f = nb_func_data(self);
+    std::string name = "trtllm::nanobind::";
+    if (f->flags & (uint32_t) func_flags::has_scope) {
+        const bool module_scope = PyModule_Check(f->scope);
+        object module = steal<object>(PyObject_GetAttrString(
+            f->scope, module_scope ? "__name__" : "__module__"));
+        name += nb_func_profiler_utf8(module.ptr());
+        name += '.';
+        if (!module_scope) {
+            object qualname = steal<object>(
+                PyObject_GetAttrString(f->scope, "__qualname__"));
+            name += nb_func_profiler_utf8(qualname.ptr());
+            name += '.';
+        }
+    }
+    name += (f->flags & (uint32_t) func_flags::has_name)
+                ? f->name : "<anonymous>";
+    return name;
+}
+
+class nb_func_record_scope {
+public:
+    nb_func_record_scope(PyObject *self, PyObject *const *args,
+                         size_t nargs, PyObject *kwnames) noexcept {
+        nb_func_profiler_error_state error_state;
+        try {
+            record.emplace(tensorrt_llm::common::ProfilerRegion::kNanobind);
+            record->startWithLazyName(
+                [&]() { return nb_func_profiler_name(self); },
+                [&](tensorrt_llm::common::ProfilerMetadata &metadata) {
+                    const size_t nkwargs =
+                        kwnames ? (size_t) NB_TUPLE_GET_SIZE(kwnames) : 0;
+                    size_t tensor_index = 0;
+                    for (size_t i = 0; i < nargs + nkwargs; ++i) {
+                        if (!trtllm_pytorch_profiler::isTensor(args[i]))
+                            continue;
+                        at::Tensor tensor =
+                            trtllm_pytorch_profiler::unpackTensor(args[i]);
+                        std::string prefix = "nanobind.tensor." +
+                                             std::to_string(tensor_index++);
+                        metadata.add(prefix + ".shape", tensor.sizes().vec());
+                        if (tensor.layout() == c10::kStrided)
+                            metadata.add(prefix + ".stride", tensor.strides().vec());
+                        metadata.add(prefix + ".dtype",
+                                     c10::toString(tensor.scalar_type()));
+                        metadata.add(prefix + ".device", tensor.device().str());
+                    }
+                    metadata.add("nanobind.tensor_count",
+                                 static_cast<std::int64_t>(tensor_index));
+                });
+        } catch (...) {
+            // Only observation is contained; dispatch remains outside this boundary.
+            record.reset();
+        }
+    }
+
+    ~nb_func_record_scope() noexcept {
+        nb_func_profiler_error_state error_state;
+        record.reset();
+    }
+    nb_func_record_scope(const nb_func_record_scope &) = delete;
+    nb_func_record_scope &operator=(const nb_func_record_scope &) = delete;
+
+private:
+    std::optional<tensorrt_llm::common::RecordFunctionWithMetadata> record;
+};
+#endif
