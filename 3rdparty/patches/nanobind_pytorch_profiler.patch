+#if TRTLLM_ENABLE_NANOBIND_PROFILING
+/// Cache qualified trace labels without changing accessor names, scopes, or ABI.
+static void property_set_profiler_name(PyObject *scope, const char *name,
+                                       PyObject *getter, PyObject *setter) noexcept {
+    error_scope error_state;
+    try {
+        object module = steal(PyObject_GetAttrString(scope, "__module__"));
+        object qualname = steal(PyObject_GetAttrString(scope, "__qualname__"));
+        if (!module.is_valid() || !qualname.is_valid() ||
+            !PyUnicode_Check(module.ptr()) || !PyUnicode_Check(qualname.ptr()))
+            throw std::runtime_error("nanobind property profiler scope unavailable");
+        object label = steal(PyUnicode_FromFormat(
+            "%U.%U.%s", module.ptr(), qualname.ptr(), name));
+        const char *label_utf8 = label.is_valid() ? PyUnicode_AsUTF8(label.ptr()) : nullptr;
+        if (!label_utf8)
+            throw std::runtime_error("nanobind property profiler name unavailable");
+        const size_t label_size = strlen(label_utf8) + 1;
+        PyObject *accessors[] = { getter, setter };
+        for (PyObject *accessor : accessors) {
+            if (!accessor || (Py_TYPE(accessor) != internals->nb_func &&
+                              Py_TYPE(accessor) != internals->nb_method))
+                continue;
+            func_data *f = nb_func_data(accessor);
+            for (Py_ssize_t i = 0; i < Py_SIZE(accessor); ++i) {
+                if (!(f[i].flags & (uint32_t) func_flags::has_name) || !f[i].name)
+                    continue;
+                const size_t name_size = strlen(f[i].name) + 1;
+                if (name_size > std::numeric_limits<size_t>::max() - label_size)
+                    throw std::bad_alloc();
+                char *packed = (char *) malloc(name_size + label_size);
+                if (!packed)
+                    throw std::bad_alloc();
+                // One owned allocation retains the exact public name before the
+                // first NUL and a private trace label after it. Existing overload
+                // moves and deallocation retain their pointer/flags ownership.
+                memcpy(packed, f[i].name, name_size);
+                memcpy(packed + name_size, label_utf8, label_size);
+                free((char *) f[i].name);
+                f[i].name = packed;
+                f[i].flags |= (uint32_t) func_flags::has_profiler_name;
+            }
+        }
+    } catch (const std::exception &error) {
+        tensorrt_llm::common::reportProfilerFailure(error.what());
+    } catch (...) {
+        tensorrt_llm::common::reportProfilerFailure(
+            "non-standard exception naming a nanobind property");
+    }
+}
+
+#endif
