diff --git a/include/cutlass/arch/config.h b/include/cutlass/arch/config.h
index 995d82ee..b87abd14 100644
--- a/include/cutlass/arch/config.h
+++ b/include/cutlass/arch/config.h
@@ -85,7 +85,10 @@
 // SM100, SM100a
 #if !CUTLASS_CLANG_CUDA && (__CUDACC_VER_MAJOR__ > 12 || (__CUDACC_VER_MAJOR__ == 12 && __CUDACC_VER_MINOR__ >= 8))
   #define CUTLASS_ARCH_MMA_SM100_SUPPORTED 1
-  #if (!defined(CUTLASS_ARCH_MMA_SM100_ENABLED) && defined(__CUDA_ARCH__) && __CUDA_ARCH__ == 1000)
+  // SM107 (Rubin) reuses the SM100 (Blackwell) kernel family. Treat __CUDA_ARCH__ 1070
+  // like 1000 so the sm_107f cubin enables SM100 MMA/TMA/tcgen05 instead of the disabled
+  // PTX stubs (which crash with cudaErrorLaunchFailure).
+  #if (!defined(CUTLASS_ARCH_MMA_SM100_ENABLED) && defined(__CUDA_ARCH__) && (__CUDA_ARCH__ == 1000 || __CUDA_ARCH__ == 1070))
     #define CUTLASS_ARCH_MMA_SM100_ENABLED 1

     #if (!defined(CUTLASS_ARCH_MMA_SM100A_ENABLED) && defined(__CUDA_ARCH_FEAT_SM100_ALL))
@@ -97,7 +100,7 @@
     #define CUTLASS_ARCH_MMA_SM100F_SUPPORTED 1
     #endif

-    #if (!defined(CUTLASS_ARCH_MMA_SM100F_ENABLED) && CUDA_ARCH_FAMILY(1000))
+    #if (!defined(CUTLASS_ARCH_MMA_SM100F_ENABLED) && (CUDA_ARCH_FAMILY(1000) || CUDA_ARCH_FAMILY(1070)))
       #define CUTLASS_ARCH_MMA_SM100F_ENABLED CUTLASS_ARCH_MMA_SM100F_SUPPORTED
     #endif
   #endif
diff --git a/include/cute/config.hpp b/include/cute/config.hpp
index fc5b1167..ce575b46 100644
--- a/include/cute/config.hpp
+++ b/include/cute/config.hpp
@@ -112,0 +113,28 @@
+#if defined(__CUDACC_RTC__)
+// Load the tuple protocol from the layout provided by the active CCCL version.
+// Older CUDA toolkits may not provide the public <cuda/std/tuple> entry point,
+// while newer releases may remove the legacy detail/libcxx include path.
+#  if defined(__has_include)
+#    if __has_include(<cuda/std/__tuple_dir/structured_bindings.h>)
+#      include <cuda/std/__tuple_dir/structured_bindings.h>
+#    elif __has_include(<cuda/std/detail/libcxx/include/__tuple_dir/structured_bindings.h>)
+#      include <cuda/std/detail/libcxx/include/__tuple_dir/structured_bindings.h>
+#    elif __has_include(<cuda/std/tuple>)
+#      include <cuda/std/tuple>
+#      if !__has_include(<cuda/std/__cccl/version.h>)
+#        define CUTE_CUDA_STD_NEEDS_TUPLE_PRIMARY_DECLARATIONS
+#      endif
+#    elif __has_include(<cuda/std/__tuple_dir/tuple_size.h>) && \
+          __has_include(<cuda/std/__tuple_dir/tuple_element.h>)
+#      include <cuda/std/__tuple_dir/tuple_size.h>
+#      include <cuda/std/__tuple_dir/tuple_element.h>
+#    else
+#      define CUTE_CUDA_STD_NEEDS_TUPLE_PRIMARY_DECLARATIONS
+#    endif
+#  elif (__CUDACC_VER_MAJOR__ >= 13)
+#    include <cuda/std/tuple>
+#  else
+#    define CUTE_CUDA_STD_NEEDS_TUPLE_PRIMARY_DECLARATIONS
+#  endif
+#endif
+
