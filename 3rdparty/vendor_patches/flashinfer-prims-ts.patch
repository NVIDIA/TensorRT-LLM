+    if spec.is_compiled:
+        return
+    lock = FileLock(get_tmpdir() / f"{spec.module_dir_name}.{spec.kernel_name}.lock", thread_local=False)
+    if _SKIP_BUSY.get():
+        try:
+            lock.acquire(timeout=0)
+        except Timeout:
+            raise KernelBusy(spec.name) from None
+    else:
+        lock.acquire()
+    try:
+        if spec.is_compiled:
+            return
+        spec.compile_and_persist()
+    finally:
+        lock.release()
