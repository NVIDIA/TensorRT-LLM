+@_dsl_user_op
+def _max3_abs(a: _F32, b: _F32, c: _F32, *, loc=None, ip=None) -> _F32:
+    return _F32(
+        _llvm.inline_asm(
+            _T.f32(),
+            [_irv(_F32(a), loc, ip), _irv(_F32(b), loc, ip), _irv(_F32(c), loc, ip)],
+            "max.abs.f32 $0, $1, $2, $3;",
+            "=f,f,f,f",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=_llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
