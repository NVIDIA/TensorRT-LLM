+@_dsl_user_op
+def _cluster_sync_all(*, loc=None, ip=None):
+    _llvm.inline_asm(
+        None,
+        [],
+        "barrier.cluster.arrive.release.aligned;\nbarrier.cluster.wait.acquire.aligned;",
+        "",
+        has_side_effects=True,
+        is_align_stack=False,
+        asm_dialect=_llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
