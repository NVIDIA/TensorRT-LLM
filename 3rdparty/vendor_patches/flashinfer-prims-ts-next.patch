+@functools.cache
+def _kernel_source_digest() -> str:
+    # TRT-LLM vendor change: the sources' content digest over package-relative
+    # names, carried in every kernel name instead of the module metadata. The
+    # cache is then shared by every tree path with identical sources, and
+    # processes never wipe a module directory that another process (another
+    # tree, another package snapshot) keyed differently.
+    root = Path(__file__).resolve().parent
+    sha = hashlib.sha256()
+    for path in sorted(root.rglob("*.py")):
+        sha.update(path.relative_to(root).as_posix().encode())
+        sha.update(path.read_bytes())
+    return sha.hexdigest()[:16]
+
