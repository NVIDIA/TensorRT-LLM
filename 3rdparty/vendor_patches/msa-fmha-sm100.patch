+                idx = tile_begin + tOcO_store[0, m, 0][0]
+                if idx < total_flat:
+                    row_q, row_h = divmod(idx, head_divmod)
+                    mO_row = cute.tiled_divide(mO[row_q, row_h, None], (elems_per_store,))
