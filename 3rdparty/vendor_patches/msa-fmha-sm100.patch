+            lse_sum_cur = 0.0
+            for sp in cutlass.range(lse_splits, unroll_full=True):
+                scale = cute.math.exp2(
+                    ts2rrLSE[0, sp, m] * LOG2_E - (lse_max_cur * LOG2_E), fastmath=True
+                )
+                lse_sum_cur += scale
