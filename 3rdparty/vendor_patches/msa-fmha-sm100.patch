+                    o2, o3 = cute.arch.mul_packed_f32x2((o2, o3), (output_scale, output_scale))
+                    o4, o5 = cute.arch.mul_packed_f32x2((o4, o5), (output_scale, output_scale))
+                    o6, o7 = cute.arch.mul_packed_f32x2((o6, o7), (output_scale, output_scale))
