+                partner1 = cute.arch.shuffle_sync_bfly(stage3, offset=2)
+                partner2 = cute.arch.shuffle_sync_bfly(stage0, offset=2)
+                partner3 = cute.arch.shuffle_sync_bfly(stage1, offset=2)
